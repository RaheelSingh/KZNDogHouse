
# KZN Doghouse - Git Ignore

# Environment variables and secrets
.env
.env.local
.env.development
.env.production
.env.test

# Local application configuration
appsettings.Local.json
secrets.json

# Certificates / private keys
*.pfx
*.p12
*.pem
*.key
*.crt

# Firebase local/native configuration
google-services.json
GoogleService-Info.plist

# ASP.NET Core / .NET
bin/
obj/
[Bb]uild/
[Dd]ebug/
[Rr]elease/
publish/

*.user
*.rsuser
*.suo
*.userosscache
*.sln.docstates

.vs/

# Test output
TestResults/
coverage/
coverage.xml
coverage.json
*.coverage
*.coveragexml

# Node / React Native / Expo
node_modules/

.expo/
.expo-shared/

dist/
build/
web-build/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Expo / EAS temporary files
.eas/

# IDEs
.idea/

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
*.tmp
*.temp
*.cache

# Local uploads / generated files
uploads/
tmp/

# Sensitive client/reference material
docs/private/

# Firebase / Supabase secrets - never commit
*firebase-adminsdk*.json
service-account*.json
supabase/.temp/
supabase/functions/.env