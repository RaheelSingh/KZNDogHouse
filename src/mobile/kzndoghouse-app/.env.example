# KZN Doghouse Mobile App - Environment Variable Template
#
# Copy this file locally as ".env".
# NEVER commit real credentials or your actual .env file.

# Supabase (client-safe — anon key only, never the service-role key)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ASP.NET Core REST API (web-foundation branch)
# Used for role lookups and any other backend-mediated data.
EXPO_PUBLIC_API_BASE_URL=