@model IReadOnlyList<VolunteerApplicationListItem>
@using KZNDoghouse.Web.Constants

@{
    ViewData["Title"] = "Volunteers";
    Layout = "_PortalLayout";
    var pendingCount = Model.Count(x => x.Assignment.Status == EventAssignmentStatuses.Pending);
    var events = Model.Select(x => x.Event).GroupBy(x => x.Id)
        .Select(g => g.First()).OrderBy(x => x.StartAt).ToList();
}

<div class="portal-page-heading">
    <div>
        <h1 class="portal-page-title mb-2">Volunteers</h1>
        <p class="text-muted mb-0">Review volunteer applications for shelter events.</p>
    </div>
    <span class="portal-summary-chip">@pendingCount awaiting review</span>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="portal-card portal-workspace-filter-card">
    <div class="portal-filter-heading"><h2>Search &amp; Filter</h2></div>

    <div class="portal-filter-bar portal-filter-bar-availability"
         data-portal-filter="volunteerApplicationRows"
         data-portal-empty="volunteerApplicationEmpty"
         data-portal-result-count="volunteerApplicationCount">
        <div class="portal-filter-search">
            <input type="search" class="form-control"
                   placeholder="Search volunteer or event"
                   aria-label="Search volunteer applications" data-portal-search />
        </div>

        <div>
            <select class="form-select" aria-label="Filter by application status"
                    data-portal-filter-field="status">
                <option value="">All statuses</option>
                @foreach (var status in EventAssignmentStatuses.All)
                {
                    var label = status switch
                    {
                        EventAssignmentStatuses.Reserve => "Standby",
                        EventAssignmentStatuses.Declined => "Not selected",
                        EventAssignmentStatuses.Assigned or EventAssignmentStatuses.Registered => "Confirmed (previous)",
                        _ => status
                    };
                    <option value="@status">@label</option>
                }
            </select>
        </div>

        <div>
            <select class="form-select" aria-label="Filter by event"
                    data-portal-filter-field="event">
                <option value="">All events</option>
                @foreach (var evt in events)
                {
                    <option value="@evt.Id">@evt.Title (@evt.StartAt.ToString("dd MMM yyyy"))</option>
                }
            </select>
        </div>

        <div class="portal-filter-date">
            <label>Event from</label>
            <input type="date" class="form-control" data-portal-date-from="date" />
        </div>
        <div class="portal-filter-date">
            <label>Event to</label>
            <input type="date" class="form-control" data-portal-date-to="date" />
        </div>
        <button type="button" class="btn btn-kzn-outline portal-filter-reset"
                data-portal-filter-reset>Reset</button>
    </div>

    <div class="portal-filter-summary">
        <span id="volunteerApplicationCount">@Model.Count @(Model.Count == 1 ? "result" : "results")</span>
        <span>Pending applications first</span>
    </div>
</div>

<div class="portal-card portal-list-card">
    <div class="table-responsive portal-filter-results portal-table-scroll">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Volunteer</th>
                    <th>Event</th>
                    <th>Event date</th>
                    <th>Volunteer shift</th>
                    <th>Places</th>
                    <th>Status</th>
                    <th>Applied</th>
                    <th class="text-end">Review</th>
                </tr>
            </thead>
            <tbody id="volunteerApplicationRows">
                @foreach (var item in Model)
                {
                    var assignment = item.Assignment;
                    var evt = item.Event;
                    var isConfirmed = EventAssignmentStatuses.CountsTowardCapacity(assignment.Status);
                    var hasSpace = evt.MaxVolunteers.HasValue && item.ConfirmedCount < evt.MaxVolunteers.Value;
                    var canReview = evt.VolunteerSignupEnabled && evt.StartAt > DateTime.UtcNow
                        && assignment.Status != EventAssignmentStatuses.Cancelled;
                    var label = assignment.Status switch
                    {
                        EventAssignmentStatuses.Reserve => "Standby",
                        EventAssignmentStatuses.Declined => "Not selected",
                        EventAssignmentStatuses.Assigned or EventAssignmentStatuses.Registered => "Confirmed",
                        _ => assignment.Status
                    };
                    <tr data-portal-row
                        data-search="@item.VolunteerName @evt.Title @evt.Location"
                        data-status="@assignment.Status"
                        data-event="@evt.Id"
                        data-date="@evt.StartAt.ToString("yyyy-MM-dd")">
                        <td><strong>@item.VolunteerName</strong></td>
                        <td>
                            <strong>@evt.Title</strong>
                            @if (!string.IsNullOrWhiteSpace(evt.Location))
                            {
                                <div class="small text-muted">@evt.Location</div>
                            }
                        </td>
                        <td>@evt.StartAt.ToString("dd MMM yyyy, HH:mm")</td>
                        <td>
                            @if (evt.VolunteerStartAt.HasValue && evt.VolunteerEndAt.HasValue)
                            {
                                <span>@evt.VolunteerStartAt.Value.ToString("dd MMM, HH:mm")–@evt.VolunteerEndAt.Value.ToString("HH:mm")</span>
                            }
                            else
                            {
                                <span class="text-muted">Not specified</span>
                            }
                        </td>
                        <td>
                            @if (evt.MaxVolunteers.HasValue)
                            {
                                <span>@item.ConfirmedCount / @evt.MaxVolunteers.Value</span>
                            }
                            else
                            {
                                <span class="text-muted">–</span>
                            }
                        </td>
                        <td><span class="portal-calendar-badge">@label</span></td>
                        <td>@assignment.CreatedAt.ToString("dd MMM, HH:mm")</td>
                        <td class="text-end">
                            @if (canReview)
                            {
                                <form asp-controller="Availability" asp-action="Review"
                                      method="post" class="d-flex flex-wrap gap-1 justify-content-end">
                                    <input type="hidden" name="assignmentId" value="@assignment.Id" />
                                    <button type="submit" class="btn btn-kzn-primary btn-sm" name="status" value="Confirmed"
                                            disabled="@(isConfirmed || !hasSpace)">Confirm</button>
                                    <button type="submit" class="btn btn-kzn-outline btn-sm" name="status" value="Reserve"
                                            disabled="@(assignment.Status == EventAssignmentStatuses.Reserve)">Standby</button>
                                    <button type="submit" class="btn btn-kzn-outline btn-sm" name="status" value="Declined"
                                            disabled="@(assignment.Status == EventAssignmentStatuses.Declined)">Not selected</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">@(assignment.Status == EventAssignmentStatuses.Cancelled ? "Withdrawn" : "Reviewed / closed")</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div id="volunteerApplicationEmpty" class="portal-filter-empty" hidden>
        No volunteer event applications match the current filters.
    </div>
</div>
