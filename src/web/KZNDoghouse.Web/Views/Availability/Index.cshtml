@model IReadOnlyList<AvailabilitySlotListItem>

@{
    ViewData["Title"] = "Availability";
    Layout = "_PortalLayout";
}

<div class="mb-4">
    <h1 class="portal-page-title mb-2">Availability</h1>
    <p class="text-muted mb-0">Review pending volunteer availability submissions.</p>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

<div class="portal-card">

    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Volunteer</th>
                    <th>Week</th>
                    <th>Day</th>
                    <th>Slot</th>
                    <th>Submitted</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                
@foreach (var item in Model)
{
    var slot = item.Slot;

    <tr>
        <td>@item.VolunteerName</td>
        <td>@slot.WeekStart.ToString("dd MMM yyyy")</td>
        <td>@slot.DayDate.ToString("ddd dd MMM")</td>
        <td>@slot.Slot</td>
        <td>@slot.SubmittedAt.ToString("dd MMM, HH:mm")</td>
        <td class="text-end d-flex gap-2 justify-content-end">
            <form asp-controller="Availability" asp-action="Approve" asp-route-id="@slot.Id" method="post">
                <button type="submit" class="btn btn-kzn-primary btn-sm">Approve</button>
            </form>
            <form asp-controller="Availability" asp-action="Reject" asp-route-id="@slot.Id" method="post">
                <button type="submit" class="btn btn-kzn-outline btn-sm">Reject</button>
            </form>
        </td>
    </tr>
}

@if (!Model.Any())
{
    <tr><td colspan="6" class="text-center text-muted py-4">No pending submissions.</td></tr>
}
            </tbody>
        </table>
    </div>

</div>