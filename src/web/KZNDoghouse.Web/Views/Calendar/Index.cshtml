@model IReadOnlyList<CalendarEvent>
@using KZNDoghouse.Web.Constants

@{
    ViewData["Title"] = "Calendar";
    Layout = "_PortalLayout";

    var grouped = Model
        .GroupBy(x => x.StartAt.Date)
        .OrderByDescending(g => g.Key);
}

<div class="portal-page-heading">
    <div>
        <h1 class="portal-page-title mb-2">Calendar</h1>
        <p class="text-muted mb-0">Manage internal and public shelter events.</p>
    </div>

    <span class="portal-summary-chip">
        @Model.Count event@(Model.Count == 1 ? string.Empty : "s")
    </span>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="portal-workspace-grid portal-equal-workspace" data-equal-workspace>
    <section class="portal-workspace-main">

        <div class="portal-card portal-workspace-filter-card">
            <div class="portal-filter-heading">
                <h2>Search &amp; Filter</h2>
            </div>

            <div class="portal-filter-bar portal-filter-bar-calendar"
                 data-portal-filter="calendarRows"
                 data-portal-empty="calendarEmpty"
                 data-portal-result-count="calendarResultCount">

                <div class="portal-filter-search">
                    <input type="search"
                           class="form-control"
                           placeholder="Search title, location or notes"
                           aria-label="Search events"
                           data-portal-search />
                </div>

                <div>
                    <select class="form-select"
                            aria-label="Filter events by category"
                            data-portal-filter-field="category">
                        <option value="">All categories</option>
                        @foreach (var category in EventCategories.All)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                </div>

                <div>
                    <select class="form-select"
                            aria-label="Filter events by visibility"
                            data-portal-filter-field="visibility">
                        <option value="">All visibility</option>
                        @foreach (var visibility in EventVisibilities.All)
                        {
                            <option value="@visibility">@visibility</option>
                        }
                    </select>
                </div>

                <div class="portal-filter-date">
                    <label>From</label>
                    <input type="date"
                           class="form-control"
                           data-portal-date-from="date" />
                </div>

                <div class="portal-filter-date">
                    <label>To</label>
                    <input type="date"
                           class="form-control"
                           data-portal-date-to="date" />
                </div>

                <button type="button"
                        class="btn btn-kzn-outline portal-filter-reset"
                        data-portal-filter-reset>
                    Reset
                </button>
            </div>

            <div class="portal-filter-summary">
                <span id="calendarResultCount">@Model.Count results</span>
                <span>Newest events first</span>
            </div>
        </div>

        <div id="calendarRows"
             class="portal-record-scroll portal-record-scroll-workspace portal-filter-results"
             data-equal-workspace-scroll>

            @foreach (var day in grouped)
            {
                <section class="portal-card portal-calendar-day" data-portal-group>
                    <div class="portal-calendar-day-heading">
                        <h2>@day.Key.ToString("dddd, dd MMMM yyyy")</h2>
                        <span>@day.Count() event@(day.Count() == 1 ? string.Empty : "s")</span>
                    </div>

                    <div class="portal-calendar-event-list">
                        @foreach (var evt in day.OrderByDescending(x => x.StartAt))
                        {
                            <article class="portal-calendar-event"
                                     data-portal-row
                                     data-search="@evt.Title @evt.Location @evt.Description @evt.Category"
                                     data-category="@evt.Category"
                                     data-visibility="@evt.Visibility"
                                     data-date="@evt.StartAt.ToString("yyyy-MM-dd")">

                                <div class="portal-calendar-event-media">
                                    @if (!string.IsNullOrWhiteSpace(evt.ImageUrl))
                                    {
                                        <img src="@evt.ImageUrl"
                                             alt="Image for @evt.Title"
                                             class="portal-event-image" />
                                    }
                                    else
                                    {
                                        <div class="portal-event-image portal-event-image-placeholder" aria-hidden="true">
                                            @evt.StartAt.ToString("dd")
                                        </div>
                                    }
                                </div>

                                <div class="portal-calendar-event-body">
                                    <div class="portal-calendar-event-title-row">
                                        <div>
                                            <h3>@evt.Title</h3>
                                            <div class="portal-calendar-event-time">
                                                @evt.StartAt.ToString("HH:mm")
                                                @if (evt.EndAt.HasValue)
                                                {
                                                    <text> – @evt.EndAt.Value.ToString("HH:mm")</text>
                                                }
                                            </div>
                                        </div>

                                        <div class="portal-calendar-badges">
                                            <span class="portal-calendar-badge">@evt.Category</span>
                                            <span class="portal-calendar-badge @(evt.Visibility == EventVisibilities.Public ? "portal-calendar-badge-public" : string.Empty)">
                                                @evt.Visibility
                                            </span>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(evt.Location))
                                    {
                                        <div class="text-muted small mt-1">@evt.Location</div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(evt.Description))
                                    {
                                        <p class="portal-calendar-event-description">@evt.Description</p>
                                    }

                                    <div class="portal-calendar-event-actions">
                                        <details class="portal-inline-editor">
                                            <summary>@(string.IsNullOrWhiteSpace(evt.ImageUrl) ? "Add image" : "Replace image")</summary>
                                            <form asp-controller="Calendar"
                                                  asp-action="UpdateImage"
                                                  asp-route-id="@evt.Id"
                                                  method="post"
                                                  enctype="multipart/form-data"
                                                  class="portal-inline-editor-form">
                                                <input type="file"
                                                       name="imageFile"
                                                       class="form-control form-control-sm"
                                                       accept="image/jpeg,image/png,image/webp"
                                                       required />
                                                <button type="submit" class="btn btn-kzn-outline btn-sm">Upload</button>
                                            </form>
                                        </details>

                                        <form asp-controller="Calendar"
                                              asp-action="Delete"
                                              asp-route-id="@evt.Id"
                                              method="post"
                                              onsubmit="return confirm('Remove this event?');">
                                            <button type="submit" class="btn btn-outline-danger btn-sm">Remove</button>
                                        </form>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }
        </div>

        <div id="calendarEmpty" class="portal-card portal-filter-empty" hidden>
            No events match the current search and filters.
        </div>

        @if (!Model.Any())
        {
            <div class="portal-card text-center text-muted py-4">No events scheduled yet.</div>
        }
    </section>

    <aside class="portal-workspace-aside">
        <div class="portal-card portal-workspace-form-card" data-equal-workspace-form>
            <h2 class="portal-workspace-form-title">New event</h2>
            <p class="text-muted small">Create an internal shelter event or publish an event to the public website.</p>

            <form asp-controller="Calendar"
                  asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                <div class="mb-3">
                    <label class="form-label">Event title</label>
                    <input name="title" class="form-control" maxlength="150" required />
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-sm-6 col-xl-12 col-xxl-6">
                        <label class="form-label">Start</label>
                        <input type="datetime-local" name="startAt" class="form-control" required />
                    </div>
                    <div class="col-sm-6 col-xl-12 col-xxl-6">
                        <label class="form-label">End</label>
                        <input type="datetime-local" name="endAt" class="form-control" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Category</label>
                    <select name="category" class="form-select">
                        @foreach (var category in EventCategories.All)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Location</label>
                    <input name="location" class="form-control" maxlength="200" />
                </div>

                <div class="mb-3">
                    <label class="form-label d-block">Visibility</label>

                    <div class="portal-calendar-visibility"
                         data-calendar-visibility
                         role="group"
                         aria-label="Event visibility">

                        <input type="radio"
                               class="visually-hidden"
                               name="visibility"
                               id="visInternal"
                               value="@EventVisibilities.Internal"
                               checked />

                        <label class="portal-calendar-visibility-option is-selected"
                               data-calendar-visibility-internal
                               for="visInternal">
                            Internal calendar
                        </label>

                        <input type="radio"
                               class="visually-hidden"
                               name="visibility"
                               id="visPublic"
                               value="@EventVisibilities.Public" />

                        <label class="portal-calendar-visibility-option"
                               data-calendar-visibility-public
                               for="visPublic">
                            Public website
                        </label>
                    </div>

                    <div class="form-text">
                        Public events also remain visible on the internal calendar.
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea name="description" class="form-control" rows="3" maxlength="1500"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Event image</label>
                    <input type="file"
                           name="imageFile"
                           class="form-control"
                           accept="image/jpeg,image/png,image/webp" />
                    <div class="form-text">Optional. Public events use this image on the website.</div>
                </div>

                <button type="submit" class="btn btn-kzn-primary w-100">Save event</button>
            </form>
        </div>
    </aside>
</div>
