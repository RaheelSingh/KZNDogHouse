@model IReadOnlyList<CalendarEvent>
@using KZNDoghouse.Web.Constants

@{
    ViewData["Title"] = "Calendar";
    Layout = "_PortalLayout";

    var grouped = Model
        .GroupBy(x => x.StartAt.Date)
        .OrderBy(g => g.Key);
}

<div class="mb-4">
    <h1 class="portal-page-title mb-2">Calendar</h1>
    <p class="text-muted mb-0">Manage internal and public shelter events.</p>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

<div class="row g-4">

    <div class="col-lg-8">

        <div class="portal-card mb-3">

            <div class="portal-filter-bar"
                 data-portal-filter="calendarRows"
                 data-portal-empty="calendarEmpty"
                 data-portal-result-count="calendarResultCount">

                <div class="portal-filter-search">
                    <input type="search"
                           class="form-control"
                           placeholder="Search title, location or notes"
                           aria-label="Search events"
                           data-portal-search />
                </div>

                <div>
                    <select class="form-select"
                            aria-label="Filter events by category"
                            data-portal-filter-field="category">
                        <option value="">All categories</option>
                        @foreach (var category in EventCategories.All)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                </div>

                <div>
                    <select class="form-select"
                            aria-label="Filter events by visibility"
                            data-portal-filter-field="visibility">
                        <option value="">All visibility</option>
                        @foreach (var visibility in EventVisibilities.All)
                        {
                            <option value="@visibility">@visibility</option>
                        }
                    </select>
                </div>

                <div class="portal-filter-date">
                    <label>From</label>
                    <input type="date"
                           class="form-control"
                           data-portal-date-from="date" />
                </div>

                <div class="portal-filter-date">
                    <label>To</label>
                    <input type="date"
                           class="form-control"
                           data-portal-date-to="date" />
                </div>

                <button type="button"
                        class="btn btn-kzn-outline portal-filter-reset"
                        data-portal-filter-reset>
                    Reset
                </button>

            </div>

            <div class="portal-filter-summary">
                <span id="calendarResultCount">@Model.Count results</span>
            </div>

        </div>

        <div id="calendarRows"
             class="portal-filter-results portal-filter-results-cards">

            @foreach (var day in grouped)
            {
                <div class="portal-card mb-3"
                     data-portal-group>

                    <h6 class="kzn-card-title">
                        @day.Key.ToString("dddd, dd MMMM yyyy")
                    </h6>

                    @foreach (var evt in day.OrderBy(x => x.StartAt))
                    {
                        <div class="d-flex justify-content-between align-items-start border-bottom py-2 portal-event-row"
                             data-portal-row
                             data-search="@evt.Title @evt.Location @evt.Description @evt.Category"
                             data-category="@evt.Category"
                             data-visibility="@evt.Visibility"
                             data-date="@evt.StartAt.ToString("yyyy-MM-dd")">

                            <div>
                                <div class="fw-semibold">
                                    @evt.StartAt.ToString("HH:mm")
                                    @if (evt.EndAt.HasValue)
                                    {
                                        <text> – @evt.EndAt.Value.ToString("HH:mm")</text>
                                    }
                                    &nbsp;@evt.Title
                                </div>

                                <div class="text-muted small">
                                    @evt.Category
                                    @if (!string.IsNullOrWhiteSpace(evt.Location))
                                    {
                                        <text> · @evt.Location</text>
                                    }
                                    · @evt.Visibility
                                </div>

                                @if (!string.IsNullOrWhiteSpace(evt.Description))
                                {
                                    <div class="small mt-1">@evt.Description</div>
                                }
                            </div>

                            <form asp-controller="Calendar"
                                  asp-action="Delete"
                                  asp-route-id="@evt.Id"
                                  method="post">
                                <button type="submit" class="btn btn-kzn-outline btn-sm">
                                    Remove
                                </button>
                            </form>

                        </div>
                    }

                </div>
            }

        </div>

        <div id="calendarEmpty"
             class="portal-card portal-filter-empty"
             hidden>
            No events match the current search and filters.
        </div>

        @if (!Model.Any())
        {
            <div class="portal-card text-center text-muted py-4">
                No events scheduled yet.
            </div>
        }

    </div>

    <div class="col-lg-4">

        <div class="portal-card">

            <h5 class="kzn-card-title">New event</h5>

            <form asp-controller="Calendar" asp-action="Create" method="post">

                <div class="mb-3">
                    <label class="form-label">Event title</label>
                    <input name="title" class="form-control" required />
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label">Start</label>
                        <input type="datetime-local" name="startAt" class="form-control" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label">End</label>
                        <input type="datetime-local" name="endAt" class="form-control" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Category</label>
                    <select name="category" class="form-select">
                        @foreach (var category in EventCategories.All)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Location / notes</label>
                    <input name="location" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label d-block">Visibility</label>

                    <div class="btn-group" role="group">
                        <input type="radio" class="btn-check" name="visibility" id="visInternal" value="Internal" checked />
                        <label class="btn btn-kzn-outline btn-sm" for="visInternal">Internal only</label>

                        <input type="radio" class="btn-check" name="visibility" id="visPublic" value="Public" />
                        <label class="btn btn-kzn-outline btn-sm" for="visPublic">Public — show on website</label>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea name="description" class="form-control" rows="2"></textarea>
                </div>

                <button type="submit" class="btn btn-kzn-primary w-100">Save event</button>

            </form>

        </div>

    </div>

</div>
