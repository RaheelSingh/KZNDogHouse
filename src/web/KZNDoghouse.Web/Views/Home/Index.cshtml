@{
    ViewData["Title"] = "Home";
}

<div class="container py-5">

    <div class="row align-items-center">

        <div class="col-lg-7">

            <p class="text-uppercase text-muted mb-2">
                KZN Doghouse
            </p>

            <h1 class="display-4 fw-bold">
                There's no place like home.
            </h1>

            <p class="lead mt-3">
                Supporting rescued dogs through care, fostering,
                adoption and community involvement.
            </p>

            <div class="mt-4">
                <a href="#"
                   class="btn btn-dark disabled"
                   aria-disabled="true">
                    View Dogs
                </a>

                <a href="#"
                   class="btn btn-outline-dark ms-2 disabled"
                   aria-disabled="true">
                    Get Involved
                </a>
            </div>

        </div>

        <div class="col-lg-5 mt-4 mt-lg-0">

            <div class="border rounded p-5 text-center bg-light">
                Dog image area
            </div>

        </div>

    </div>

</div>