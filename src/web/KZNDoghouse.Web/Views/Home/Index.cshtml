@{
    ViewData["Title"] = "Home";
}

<section class="public-hero">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-7">

                <p class="public-hero-label">
                    KZN Doghouse
                </p>

                <h1 class="public-hero-title">
                    There's no place like home.
                </h1>

                <p class="public-hero-text mt-3">
                    Supporting rescued dogs through care, fostering,
                    adoption and community involvement.
                </p>

                <div class="mt-4">

                    <a href="#"
                       class="btn btn-kzn-primary disabled"
                       aria-disabled="true">
                        View Dogs
                    </a>

                    <a href="#"
                       class="btn btn-kzn-outline ms-2 disabled"
                       aria-disabled="true">
                        Get Involved
                    </a>

                </div>

            </div>

            <div class="col-lg-5 mt-4 mt-lg-0">

                <div class="public-image-placeholder">
                    Dog image area
                </div>

            </div>

        </div>

    </div>

</section>

<section class="public-section public-section-alt">

    <div class="container">

        <div class="public-section-heading">

            <p class="public-section-label">
                What we do
            </p>

            <h2 class="public-section-title">
                Caring for rescued dogs across KwaZulu-Natal
            </h2>

            <p class="public-section-text">
                KZN Doghouse looks after dogs and puppies that need a safe
                place to recover, and helps them find loving homes.
            </p>

        </div>

        <div class="row g-4">

            <div class="col-md-4">

                <div class="public-feature-card">

                    <span class="public-feature-number">1</span>

                    <h3>Rescue and care</h3>

                    <p>
                        Every dog receives food, shelter, vaccinations and
                        medical attention while they wait for a new start.
                    </p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="public-feature-card">

                    <span class="public-feature-number">2</span>

                    <h3>Foster and adopt</h3>

                    <p>
                        Foster parents give dogs and puppies a temporary
                        home, helping them settle before they are adopted.
                    </p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="public-feature-card">

                    <span class="public-feature-number">3</span>

                    <h3>Community involvement</h3>

                    <p>
                        Volunteers and supporters help with daily care,
                        fundraising and events throughout the year.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<section class="public-section">

    <div class="container">

        <div class="public-section-heading">

            <p class="public-section-label">
                Fostering at a glance
            </p>

            <h2 class="public-section-title">
                Open your home to a dog in need
            </h2>

            <p class="public-section-text">
                Fostering gives dogs and puppies the quiet, safe space they
                need while they wait for a permanent family.
            </p>

        </div>

        <div class="row g-4">

            <div class="col-md-4">

                <div class="public-feature-card">

                    <h3>Flexible foster periods</h3>

                    <p>
                        Choose a period that works around your availability,
                        from a few weeks to longer stays.
                    </p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="public-feature-card">

                    <h3>We provide the essentials</h3>

                    <p>
                        Food, blankets, flea medication, dewormer and other
                        dog-care items can be supplied to foster parents.
                    </p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="public-feature-card">

                    <h3>A safe, secure home</h3>

                    <p>
                        A fully fenced property, someone at home to monitor
                        the dog, and an indoor place to sleep.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>

<section class="public-cta">

    <div class="container">

        <h2>Ready to make a difference?</h2>

        <p class="mt-2">
            Foster a dog, volunteer your time or support our work.
        </p>

        <div class="mt-4">

            <a href="#"
               class="btn btn-kzn-gold disabled"
               aria-disabled="true">
                Learn about fostering
            </a>

            <a href="#"
               class="btn btn-outline-light ms-2 disabled"
               aria-disabled="true">
                Get Involved
            </a>

        </div>

    </div>

</section>
