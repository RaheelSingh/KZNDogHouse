@{
    ViewData["Title"] = "Privacy policy";
    ViewData["Eyebrow"] = "Privacy";
    ViewData["Heading"] = "Your information and our services.";
    ViewData["Subtitle"] = "How KZN Doghouse uses information on its website and mobile application.";
}

<partial name="_PublicPageHeader" />

<section class="public-section">
    <div class="container">
        <div class="public-policy-card">
            <section>
                <h2>Information collected</h2>
                <p>
                    The KZN Doghouse website and mobile app process account details such as name,
                    email address, contact information and sign-in credentials handled by our
                    authentication provider. Depending on your role and the features you use,
                    we also process volunteer applications and attendance, event responses,
                    messages, fostering requests and operational records.
                </p>
                <p>
                    On supported Android builds, notifications may use a device push token
                    to deliver relevant account, volunteer and event updates. If you choose
                    to upload photographs, those images are processed for the feature you use.
                </p>
            </section>
            <section>
                <h2>Why we use it</h2>
                <p>
                    We use this information to authenticate users, manage shelter operations,
                    coordinate volunteering and events, process fostering enquiries, respond
                    to messages, and deliver requested notifications. Access to internal
                    shelter information is restricted by account role.
                </p>
            </section>
            <section>
                <h2>Service providers and safeguards</h2>
                <p>
                    The platform uses Supabase for authentication and data storage, Render to
                    host its website and API, and Firebase Cloud Messaging for Android push
                    delivery when enabled. These services process information needed to
                    provide the application. We use access controls and secure connections,
                    but no online service can guarantee absolute security.
                </p>
            </section>
            <section>
                <h2>Retention and account deletion</h2>
                <p>
                    Records are retained while needed for shelter operations and appropriate
                    legal, security or accountability purposes. You can request deletion of
                    your account and associated personal information using our
                    <a asp-controller="Home" asp-action="AccountDeletion">account deletion request page</a>.
                    We verify requests before removing an account. Some records may need to
                    be retained where required by law or for legitimate safeguarding and
                    operational obligations; we will explain any such retention to you.
                </p>
            </section>
            <section>
                <h2>Questions and requests</h2>
                <p>
                    For privacy questions, corrections or access requests, contact
                    <a href="mailto:@PublicSiteInfo.Email">@PublicSiteInfo.Email</a>.
                </p>
            </section>
        </div>
    </div>
</section>
