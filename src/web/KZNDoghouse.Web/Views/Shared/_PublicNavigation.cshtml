@{
    var current = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;

    string Active(string controller) =>
        string.Equals(current, controller, StringComparison.OrdinalIgnoreCase)
            ? " active"
            : string.Empty;
}

<nav class="navbar navbar-expand-lg public-navbar">

    <div class="container">

        <a class="navbar-brand public-brand"
           asp-controller="Home"
           asp-action="Index">

            <img src="~/images/logo-placeholder.svg"
                 alt=""
                 width="40"
                 height="40" />

            <span>@PublicSiteInfo.Name</span>

        </a>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#publicNavbar"
                aria-controls="publicNavbar"
                aria-expanded="false"
                aria-label="Toggle navigation">

            <span class="navbar-toggler-icon"></span>

        </button>

        <div class="collapse navbar-collapse"
             id="publicNavbar">

            <ul class="navbar-nav ms-auto align-items-lg-center">

                <li class="nav-item">
                    <a class="nav-link@(Active("Home"))"
                       asp-controller="Home"
                       asp-action="Index">
                        Home
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link@(Active("Foster"))"
                       asp-controller="Foster"
                       asp-action="Index">
                        Foster
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link@(Active("GetInvolved"))"
                       asp-controller="GetInvolved"
                       asp-action="Index">
                        Get Involved
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link@(Active("Events"))"
                       asp-controller="Events"
                       asp-action="Index">
                        Events
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link@(Active("PublicDogs"))"
                       asp-controller="PublicDogs"
                       asp-action="Index">
                        Dogs
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link@(Active("Contact"))"
                       asp-controller="Contact"
                       asp-action="Index">
                        Contact
                    </a>
                </li>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole(UserRoles.Staff)
                        || User.IsInRole(UserRoles.Administrator))
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Portal"
                               asp-action="Index">
                                Portal
                            </a>
                        </li>
                    }

                    <li class="nav-item ms-lg-3">

                        <form asp-controller="Auth"
                              asp-action="Logout"
                              method="post">

                            <button type="submit"
                                    class="public-sign-in">
                                Log out
                            </button>

                        </form>

                    </li>
                }
                else
                {
                    <li class="nav-item ms-lg-3">

                        <a class="public-sign-in"
                           asp-controller="Auth"
                           asp-action="Login">
                            Sign In
                        </a>

                    </li>
                }

            </ul>

        </div>

    </div>

</nav>
