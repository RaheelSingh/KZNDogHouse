@model ErrorViewModel

@{
    ViewData["Title"] = "Something went wrong";
}

<section class="public-section">
    <div class="container">
        <div class="public-error-card" role="alert">
            <span class="public-icon-box"><partial name="_PublicIcon" model="@("heart")" /></span>
            <p class="public-eyebrow">KZN Doghouse</p>
            <h1>We couldn't complete that request.</h1>
            <p>
                Please try again. If the problem continues, you can return to the website
                or contact the shelter for help.
            </p>

            @if (Model.ShowRequestId)
            {
                <p class="public-error-reference">
                    Reference: <code>@Model.RequestId</code>
                </p>
            }

            <div class="d-flex flex-wrap gap-2 justify-content-center mt-4">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-kzn-primary">
                    Return home
                </a>
                <a asp-controller="Contact"
                   asp-action="Index"
                   class="btn btn-kzn-outline">
                    Contact us
                </a>
            </div>
        </div>
    </div>
</section>
