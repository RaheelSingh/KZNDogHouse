@model PublicDogListItem

<div class="public-dog-card">

    <partial name="_DogGallery"
             model="@(new DogGalleryViewModel
             {
                 DogName = Model.Name,
                 Initial = Model.Initial,
                 ImageUrls = Model.ImageUrls,
                 Variant = "card",
                 AutoPlay = true
             })" />

    <div class="public-dog-body">

        <h3 class="public-dog-name">
            <a asp-controller="PublicDogs"
               asp-action="Details"
               asp-route-id="@Model.Id"
               class="public-dog-link stretched-link">
                @Model.Name
            </a>
        </h3>

        <p class="public-dog-meta">@Model.MetaText</p>

        <span class="public-badge @(Model.IsFostered ? "public-badge-outline" : "public-badge-solid")">
            @Model.StatusLabel
        </span>

    </div>

</div>
