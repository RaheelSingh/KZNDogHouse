@{
    var currentController =
        ViewContext.RouteData.Values["controller"]
            ?.ToString();

    var dashboardActive =
        currentController == "Portal";

    var userAccessActive =
        currentController == "UserAccess";
}

<div class="p-3">

    <a asp-controller="Home"
    asp-action="Index"
    class="portal-sidebar-brand"
    title="Return to public website">

        <h5 class="mb-4">
            KZN Doghouse
        </h5>

    </a>

    <nav class="nav flex-column gap-1">

        <a class="nav-link @(dashboardActive ? "active" : "")"
           asp-controller="Portal"
           asp-action="Index">
            Dashboard
        </a>

        
        <a class="nav-link @(currentController == "Dogs" ? "active" : "")"
            asp-controller="Dogs"
            asp-action="Index">
             Dogs
        </a>

        <a class="nav-link @(currentController == "Calendar" ? "active" : "")"
            asp-controller="Calendar"
            asp-action="Index">
            Calendar
        </a>

        <a class="nav-link @(currentController == "Availability" ? "active" : "")"
            asp-controller="Availability"
            asp-action="Index">
            Availability
        </a>


        <a class="nav-link @(currentController == "Inventory" ? "active" : "")"
            asp-controller="Inventory"
            asp-action="Index">
            Inventory
        </a>

        <a class="nav-link disabled"
           href="#"
           aria-disabled="true">
            Notifications
        </a>

        @if (User.IsInRole(UserRoles.Administrator))
        {
            <a class="nav-link @(userAccessActive ? "active" : "")"
               asp-controller="UserAccess"
               asp-action="Index">
                Users & Access
            </a>
        }

        <a class="nav-link @(currentController == "FosterApplications" ? "active" : "")"
            asp-controller="FosterApplications"
            asp-action="Index">
            Foster Applications
        </a>

    </nav>

</div>