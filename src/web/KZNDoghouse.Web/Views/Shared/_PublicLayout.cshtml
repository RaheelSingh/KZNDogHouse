<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - KZN Doghouse</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/KZNDoghouse.Web.styles.css"
          asp-append-version="true" />
</head>

<body class="public-body">

    <header>
        <partial name="_PublicNavigation" />
    </header>

    <main role="main" class="public-main">
        @RenderBody()
    </main>

    <footer class="public-footer">
        <div class="container">
            <p>
                &copy; @DateTime.Now.Year KZN Doghouse
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>