@model UserAccessViewModel

@{
    ViewData["Title"] = "Users & Access";
    Layout = "_PortalLayout";
}

<div class="mb-4">

    <h1 class="portal-page-title mb-2">
        Users & Access
    </h1>

    <p class="text-muted mb-0">
        Manage account roles, volunteer requests and platform access.
    </p>

</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

<div class="portal-card mb-4">

    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">

        <div>

            <h5 class="mb-1">
                Pending Volunteer Requests
            </h5>

            <p class="text-muted small mb-0">
                Public users who have asked for volunteer access.
            </p>

        </div>

        <span class="text-muted small">
            @Model.PendingVolunteerRequests.Count pending
        </span>

    </div>

    @if (Model.PendingVolunteerRequests.Any())
    {
        <div class="table-responsive">

            <table class="table align-middle mb-0">

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Requested</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var request in Model.PendingVolunteerRequests)
                    {
                        <tr>

                            <td class="fw-semibold">
                                @request.FullName
                            </td>

                            <td>
                                @request.Email
                            </td>

                            <td>
                                @(request.VolunteerRequestedAt?.ToString("dd MMM yyyy HH:mm") ?? "Unknown")
                            </td>

                            <td class="text-end">

                                <div class="d-inline-flex gap-2">

                                    <form asp-controller="UserAccess"
                                          asp-action="ApproveVolunteer"
                                          method="post">

                                        <input type="hidden"
                                               name="profileId"
                                               value="@request.Id" />

                                        <button type="submit"
                                                class="btn btn-kzn-primary btn-sm">
                                            Approve
                                        </button>

                                    </form>

                                    <form asp-controller="UserAccess"
                                          asp-action="RejectVolunteer"
                                          method="post">

                                        <input type="hidden"
                                               name="profileId"
                                               value="@request.Id" />

                                        <button type="submit"
                                                class="btn btn-kzn-outline btn-sm">
                                            Reject
                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="text-muted small py-2">
            There are no volunteer requests waiting for review.
        </div>
    }

</div>

<div class="portal-card">

    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">

        <div>

            <h5 class="mb-1">
                User Accounts
            </h5>

            <p class="text-muted small mb-0">
                Search, filter and manage registered platform users.
            </p>

        </div>

        <span class="text-muted small">
            @Model.Users.Count accounts
        </span>

    </div>

    <div class="portal-filter-bar"
         data-portal-filter="userAccessRows"
         data-portal-empty="userAccessEmpty"
         data-portal-result-count="userAccessResultCount">

        <div class="portal-filter-search">

            <label for="userSearch"
                   class="visually-hidden">
                Search users
            </label>

            <input id="userSearch"
                   type="search"
                   class="form-control"
                   placeholder="Search name or email"
                   data-portal-search />

        </div>

        <div>

            <select class="form-select"
                    aria-label="Filter by role"
                    data-portal-filter-field="role">

                <option value="">
                    All roles
                </option>

                @foreach (var role in UserRoles.All)
                {
                    <option value="@role">
                        @role
                    </option>
                }

            </select>

        </div>

        <div>

            <select class="form-select"
                    aria-label="Filter by account status"
                    data-portal-filter-field="status">

                <option value="">
                    All statuses
                </option>

                <option value="Active">
                    Active
                </option>

                <option value="Inactive">
                    Inactive
                </option>

            </select>

        </div>

        <button type="button"
                class="portal-sort-button"
                data-portal-sort-toggle
                data-sort-field="sortName"
                data-sort-type="text"
                data-sort-direction="asc"
                data-sort-asc-label="A–Z"
                data-sort-desc-label="Z–A"
                title="Sort names A to Z"
                aria-label="Sort names A to Z">

            <svg class="portal-sort-icon portal-sort-icon-up"
                 viewBox="0 0 24 24"
                 aria-hidden="true">
                <path d="M4 6h9"></path>
                <path d="M4 11h6"></path>
                <path d="M4 16h3"></path>
                <path d="M18 19V5"></path>
                <path d="m15 8 3-3 3 3"></path>
            </svg>

            <svg class="portal-sort-icon portal-sort-icon-down"
                 viewBox="0 0 24 24"
                 aria-hidden="true">
                <path d="M4 6h9"></path>
                <path d="M4 11h6"></path>
                <path d="M4 16h3"></path>
                <path d="M18 5v14"></path>
                <path d="m15 16 3 3 3-3"></path>
            </svg>

            <span data-portal-sort-label>
                A–Z
            </span>

        </button>

        <button type="button"
                class="btn btn-kzn-outline portal-filter-reset"
                data-portal-filter-reset>
            Reset
        </button>

    </div>

    <div class="portal-filter-summary">
        <span id="userAccessResultCount">
            @Model.Users.Count results
        </span>
    </div>

    <div class="table-responsive portal-filter-results">

        <table class="table align-middle mb-0">

            <thead>

                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th></th>
                </tr>

            </thead>

            <tbody id="userAccessRows">

                @foreach (var user in Model.Users)
                {
                    var isCurrentUser =
                        user.AuthUserId
                            .ToString()
                            .Equals(
                                Model.CurrentAuthUserId,
                                StringComparison.OrdinalIgnoreCase);

                    var accountStatus =
                        user.IsActive
                            ? "Active"
                            : "Inactive";

                    <tr data-portal-row
                        data-search="@user.FullName @user.Email"
                        data-role="@user.Role"
                        data-status="@accountStatus"
                        data-sort-name="@user.FullName"
                        data-pinned="@(isCurrentUser ? "true" : "false")">

                        <td>

                            <div class="fw-semibold">
                                @user.FullName
                            </div>

                            @if (isCurrentUser)
                            {
                                <span class="portal-inline-note">
                                    Current account
                                </span>
                            }

                        </td>

                        <td>
                            @user.Email
                        </td>

                        <td>

                            <form id="user-form-@user.Id"
                                  asp-controller="UserAccess"
                                  asp-action="Update"
                                  method="post">

                                <input type="hidden"
                                       name="profileId"
                                       value="@user.Id" />

                                <select name="role"
                                        class="form-select"
                                        disabled="@isCurrentUser">

                                    @foreach (var role in UserRoles.All)
                                    {
                                        if (user.Role == role)
                                        {
                                            <option value="@role" selected>
                                                @role
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@role">
                                                @role
                                            </option>
                                        }
                                    }

                                </select>

                            </form>

                        </td>

                        <td>

                            <select name="isActive"
                                    form="user-form-@user.Id"
                                    class="form-select"
                                    disabled="@isCurrentUser">

                                @if (user.IsActive)
                                {
                                    <option value="true" selected>
                                        Active
                                    </option>

                                    <option value="false">
                                        Inactive
                                    </option>
                                }
                                else
                                {
                                    <option value="true">
                                        Active
                                    </option>

                                    <option value="false" selected>
                                        Inactive
                                    </option>
                                }

                            </select>

                        </td>

                        <td class="text-end">

                            <div class="d-inline-flex flex-wrap justify-content-end gap-2">

                                <button type="submit"
                                        form="user-form-@user.Id"
                                        class="btn btn-kzn-primary"
                                        disabled="@isCurrentUser">
                                    Save
                                </button>

                                @if (user.Role == UserRoles.Vet
                                    && user.IsActive)
                                {
                                    <a asp-controller="VetAccess"
                                       asp-action="Manage"
                                       asp-route-profileId="@user.Id"
                                       class="btn btn-kzn-outline">
                                        Dog access
                                    </a>
                                }

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

    <div id="userAccessEmpty"
         class="portal-filter-empty"
         hidden>
        No users match the current search and filters.
    </div>

</div>
