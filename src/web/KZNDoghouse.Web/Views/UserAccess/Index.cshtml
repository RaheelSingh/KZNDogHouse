@model IReadOnlyList<UserProfile>

@{
    ViewData["Title"] = "Users & Access";
    Layout = "_PortalLayout";

    var currentAuthUserId =
        User.FindFirst(
            System.Security.Claims.ClaimTypes.NameIdentifier)
            ?.Value;
}

<div class="mb-4">

    <h1 class="portal-page-title mb-2">
        Users & Access
    </h1>

    <p class="text-muted mb-0">
        Manage account roles and access to the KZN Doghouse platform.
    </p>

</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success"
         role="alert">
        @successMessage
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger"
         role="alert">
        @errorMessage
    </div>
}

<div class="portal-card">

    <div class="table-responsive">

        <table class="table align-middle mb-0">

            <thead>

                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th></th>
                </tr>

            </thead>

            <tbody>

                @foreach (var user in Model)
                {
                    var isCurrentUser =
                        user.AuthUserId
                            .ToString()
                            .Equals(
                                currentAuthUserId,
                                StringComparison.OrdinalIgnoreCase);

                    <tr>

                        <td>

                            <div class="fw-semibold">
                                @user.FullName
                            </div>

                            @if (isCurrentUser)
                            {
                                <span class="badge text-bg-secondary">
                                    Current account
                                </span>
                            }

                        </td>

                        <td>
                            @user.Email
                        </td>

                        <td>

                            <form id="user-form-@user.Id"
                                  asp-controller="UserAccess"
                                  asp-action="Update"
                                  method="post">

                                <input type="hidden"
                                       name="profileId"
                                       value="@user.Id" />

                                <select name="role"
                                        class="form-select"
                                        disabled="@isCurrentUser">

                                    @foreach (var role in UserRoles.All)
                                    {
                                        if (user.Role == role)
                                        {
                                            <option value="@role"
                                                    selected>
                                                @role
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@role">
                                                @role
                                            </option>
                                        }
                                    }

                                </select>

                            </form>

                        </td>

                        <td>

                            <select name="isActive"
                                    form="user-form-@user.Id"
                                    class="form-select"
                                    disabled="@isCurrentUser">

                                @if (user.IsActive)
                                {
                                    <option value="true"
                                            selected>
                                        Active
                                    </option>

                                    <option value="false">
                                        Inactive
                                    </option>
                                }
                                else
                                {
                                    <option value="true">
                                        Active
                                    </option>

                                    <option value="false"
                                            selected>
                                        Inactive
                                    </option>
                                }

                            </select>

                        </td>

                        <td class="text-end">

                            <button type="submit"
                                    form="user-form-@user.Id"
                                    class="btn btn-kzn-primary"
                                    disabled="@isCurrentUser">
                                Save
                            </button>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>