@model IReadOnlyList<ContactMessage>
@{
    ViewData["Title"] = "Contact Inbox";
    Layout = "_PortalLayout";
    var unresolved = Model.Count(m => m.Status != "Resolved");
}
<div class="portal-page-heading">
    <div><h1 class="portal-page-title">Contact Inbox</h1><p class="text-muted">Review and respond to enquiries from the public website.</p></div>
    <span class="portal-summary-chip">@unresolved open</span>
</div>
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="portal-card mb-3">
    <label class="form-label" for="contactStatusFilter">Status</label>
    <select class="form-select" id="contactStatusFilter" style="max-width:240px">
        <option value="">All messages</option><option value="New">New</option>
        <option value="Ongoing">Ongoing</option><option value="Resolved">Resolved</option>
    </select>
</div>
<div id="contactInboxResults">
    @if (!Model.Any()) { <div class="portal-card text-muted py-4">No contact messages received yet.</div> }
    @foreach (var message in Model)
    {
        <article class="portal-card portal-inbox-card" data-status="@message.Status">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <h2 class="h5 mb-1">@message.FirstName @message.LastName</h2>
                    <div class="text-muted small">@message.Topic · @message.CreatedAt.ToString("dd MMM yyyy, HH:mm")</div>
                </div>
                <span class="portal-summary-chip">@message.Status</span>
            </div>
            <p class="mt-3 mb-3" style="white-space:pre-wrap">@message.Message</p>
            <div class="d-flex gap-3 mb-3 flex-wrap">
                <a href="mailto:@message.Email">@message.Email</a>
                @if (!string.IsNullOrWhiteSpace(message.Phone))
                {
                    <a href="tel:@message.Phone">Call @message.Phone</a>
                }
            </div>
            <div class="portal-inbox-actions">
                @foreach (var state in new[] { "New", "Ongoing", "Resolved" })
                {
                    <form asp-action="UpdateStatus" method="post">
                        <input type="hidden" name="id" value="@message.Id" />
                        <input type="hidden" name="status" value="@state" />
                        <button class="btn btn-sm @(message.Status == state ? "btn-kzn-outline disabled" : "btn-kzn-outline")" disabled="@(message.Status == state)">@state</button>
                    </form>
                }
            </div>
        </article>
    }
</div>
<script>
    document.getElementById('contactStatusFilter')?.addEventListener('change', function () {
        document.querySelectorAll('#contactInboxResults [data-status]').forEach(x => {
            x.hidden = !!this.value && x.dataset.status !== this.value;
        });
    });
</script>
