@model IReadOnlyList<ContactMessage>
@{
    ViewData["Title"] = "Contact Inbox";
    Layout = "_PortalLayout";
    var unresolved = Model.Count(m => m.Status != "Resolved");
    var isAdmin = User.IsInRole("Administrator");
}
<div class="portal-page-heading">
    <div><h1 class="portal-page-title">Contact Inbox</h1><p class="text-muted">Review and respond to enquiries from the public website.</p></div>
    <span class="portal-summary-chip">@unresolved open</span>
</div>
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="portal-card mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-3"><label class="form-label" for="contactStatusFilter">Status</label>
            <select class="form-select" id="contactStatusFilter">
                <option value="">All statuses</option><option value="New">New</option>
                <option value="Ongoing">Ongoing</option><option value="Resolved">Resolved</option>
            </select></div>
        <div class="col-md-3"><label class="form-label" for="contactTopicFilter">Enquiry type</label>
            <select class="form-select" id="contactTopicFilter">
                <option value="">All enquiry types</option>
                @foreach (var topic in KZNDoghouse.Web.Constants.ContactTopics.All)
                { <option value="@topic">@topic</option> }
            </select></div>
        <div class="col-md-2"><label class="form-label" for="contactFrom">From</label><input class="form-control" type="date" id="contactFrom" /></div>
        <div class="col-md-2"><label class="form-label" for="contactTo">To</label><input class="form-control" type="date" id="contactTo" /></div>
        <div class="col-md-2"><button type="button" class="btn btn-kzn-outline w-100" id="contactFilterReset">Reset</button></div>
    </div>
</div>
<div id="contactInboxResults">
    @if (!Model.Any()) { <div class="portal-card text-muted py-4">No contact messages received yet.</div> }
    @foreach (var message in Model)
    {
        <article class="portal-card portal-inbox-card" data-status="@message.Status" data-topic="@message.Topic" data-date="@message.CreatedAt.ToString("yyyy-MM-dd")">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <h2 class="h5 mb-1">@message.FirstName @message.LastName</h2>
                    <div class="text-muted small">@message.Topic · @message.CreatedAt.ToString("dd MMM yyyy, HH:mm")</div>
                </div>
                <span class="portal-summary-chip">@message.Status</span>
            </div>
            <p class="mt-3 mb-3" style="white-space:pre-wrap">@message.Message</p>
            <div class="d-flex gap-3 mb-3 flex-wrap">
                <a href="mailto:@message.Email">@message.Email</a>
                @if (!string.IsNullOrWhiteSpace(message.Phone))
                {
                    <a href="tel:@message.Phone">Call @message.Phone</a>
                }
            </div>
            <div class="portal-inbox-actions" aria-label="Enquiry actions">
                @if (message.Status == "Resolved")
                {
                    <span class="text-muted small">Resolved</span>
                    @if (isAdmin)
                    {
                        <form asp-action="UpdateStatus" method="post">
                            <input type="hidden" name="id" value="@message.Id" />
                            <input type="hidden" name="status" value="Ongoing" />
                            <button type="submit" class="btn btn-kzn-outline btn-sm">Reopen</button>
                        </form>
                    }
                }
                else
                {
                    @if (message.Status == "New")
                    {
                        <form asp-action="UpdateStatus" method="post">
                            <input type="hidden" name="id" value="@message.Id" />
                            <input type="hidden" name="status" value="Ongoing" />
                            <button type="submit" class="btn btn-kzn-outline btn-sm">Mark ongoing</button>
                        </form>
                    }
                    @if (message.Status == "Ongoing")
                    {
                        <form asp-action="UpdateStatus" method="post">
                            <input type="hidden" name="id" value="@message.Id" />
                            <input type="hidden" name="status" value="Resolved" />
                            <button type="submit" class="btn btn-kzn-outline btn-sm">Resolve</button>
                        </form>
                    }
                }
            </div>
        </article>
    }
</div>
<script>
(() => {
    const filters = ['contactStatusFilter', 'contactTopicFilter', 'contactFrom', 'contactTo']
        .map(id => document.getElementById(id));
    const rows = Array.from(document.querySelectorAll('#contactInboxResults [data-status]'));
    const apply = () => {
        const [status, topic, from, to] = filters.map(x => x.value);
        for (const row of rows) {
            const date = row.dataset.date || '';
            row.hidden = !!((status && row.dataset.status !== status) ||
                (topic && row.dataset.topic !== topic) ||
                (from && date < from) || (to && date > to));
        }
    };
    filters.forEach(x => x.addEventListener('change', apply));
    document.getElementById('contactFilterReset')?.addEventListener('click', () => {
        filters.forEach(x => { x.value = ''; });
        apply();
    });
})();
</script>
