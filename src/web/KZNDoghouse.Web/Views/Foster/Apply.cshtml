@model FosterApplicationFormViewModel

@{
    ViewData["Title"] = "Apply to Foster";
    ViewData["Eyebrow"] = "Foster a Dog";
    ViewData["Heading"] = "Ready to open your door?";
    ViewData["Subtitle"] = "Fostering is a temporary home for a dog in need — no forever commitment, just a soft place to land while we find them one. Tell us how to reach you and what kind of fostering would suit you.";

    var choices = ViewData["FosterDogChoices"] as IReadOnlyList<PublicDogListItem> ?? Array.Empty<PublicDogListItem>();
    var selectedDogName = ViewData["SelectedDogName"] as string;
    var selectedDogPhotoUrl = ViewData["SelectedDogPhotoUrl"] as string;
    var selectedDogPhotoName = ViewData["SelectedDogPhotoName"] as string;
}

<partial name="_PublicPageHeader" />

<section class="public-section">

    <div class="container">

        <div class="row g-4">

            <div class="col-lg-7">

                <form asp-action="Apply"
                      method="post"
                      class="public-form-card"
                      novalidate>

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="DogId" class="form-label">Dog you'd like to foster (optional)</label>
                        <select asp-for="DogId" class="form-select">
                            <option value="">No preference / general foster enquiry</option>
                            @foreach (var option in choices)
                            {
                                <option value="@option.Id" data-dog-name="@option.Name" data-dog-photo="@option.PhotoUrl">@option.Name (@option.MetaText)</option>
                            }
                        </select>
                        <p class="form-text">You can apply without choosing a particular dog. The team will help match you.</p>
                    </div>

                    <p id="selectedFosterDogNote" class="public-dog-note" hidden>
                        You are applying to foster <strong id="selectedFosterDogName"></strong>.
                    </p>

                    <fieldset class="public-form-section">

                        <legend>About you</legend>

                        <p class="public-form-hint">
                            We'll use this to get in touch about your application.
                        </p>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label"></label>
                                <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label"></label>
                                <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" type="email" class="form-control" autocomplete="email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label"></label>
                                <input asp-for="Phone" type="tel" class="form-control" autocomplete="tel" placeholder="+27 82 000 0000" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="HomeAddress" class="form-label"></label>
                                <input asp-for="HomeAddress" class="form-control" autocomplete="street-address" placeholder="Street, suburb, city" />
                                <span asp-validation-for="HomeAddress" class="text-danger"></span>
                            </div>

                        </div>

                    </fieldset>

                    <fieldset class="public-form-section">

                        <legend>Fostering preferences</legend>

                        <div class="public-question" role="group" aria-labelledby="q-size" id="fosterSizePreferences">
                            <p id="q-size" class="public-question-label">What size dog could you foster? *</p>
                            <div class="public-pill-group">
                                @foreach (var option in FosterOptions.SizePreferences)
                                {
                                    <label class="public-pill public-pill-round">
                                        <input type="checkbox"
                                               name="SizePreferences"
                                               value="@option"
                                               checked="@Model.SizePreferences.Contains(option)" />
                                        <span>@option</span>
                                    </label>
                                }
                            </div>
                            <span asp-validation-for="SizePreferences" class="text-danger"></span>
                        </div>

                        <div class="public-question" role="group" aria-labelledby="q-period">
                            <p id="q-period" class="public-question-label">How long could you foster for? *</p>
                            <div class="public-pill-group">
                                @foreach (var option in FosterPeriods.All)
                                {
                                    <label class="public-pill">
                                        <input type="radio" asp-for="FosterPeriod" value="@option" />
                                        <span>@option</span>
                                    </label>
                                }
                            </div>
                            <span asp-validation-for="FosterPeriod" class="text-danger"></span>
                        </div>

                        <div class="public-question">
                            <label asp-for="Motivation" class="form-label"></label>
                            <textarea asp-for="Motivation"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Experience with dogs, what you're hoping for, anything we should know&hellip;"></textarea>
                            <span asp-validation-for="Motivation" class="text-danger"></span>
                        </div>

                        <div class="form-check">
                            <input asp-for="AgreeToTerms" class="form-check-input" />
                            <label asp-for="AgreeToTerms" class="form-check-label">
                                I agree to The KZN Doghouse's <strong>Terms</strong>
                                and <strong>Privacy Policy</strong>, and understand
                                a home check may be required before approval.
                            </label>
                            <div>
                                <span asp-validation-for="AgreeToTerms" class="text-danger"></span>
                            </div>
                        </div>

                    </fieldset>

                    <div class="d-flex flex-wrap gap-3">

                        <button type="submit" class="btn btn-kzn-primary">
                            Submit application
                        </button>

                        <a asp-action="Index" class="btn btn-kzn-outline">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>

            <div class="col-lg-5">

                <div class="public-side-card">

                    <h2>How fostering works</h2>

                    <ol class="public-side-steps">

                        <li>
                            <span>1</span>
                            <div>
                                <strong>Apply</strong>
                                <p>Send a short enquiry and we'll contact you.</p>
                            </div>
                        </li>

                        <li>
                            <span>2</span>
                            <div>
                                <strong>Home check</strong>
                                <p>A short call or visit to make sure it's a good fit.</p>
                            </div>
                        </li>

                        <li>
                            <span>3</span>
                            <div>
                                <strong>Matching</strong>
                                <p>We match you with a dog suited to your home.</p>
                            </div>
                        </li>

                        <li>
                            <span>4</span>
                            <div>
                                <strong>Foster</strong>
                                <p>We support you the whole way, from food to vet visits.</p>
                            </div>
                        </li>

                    </ol>

                </div>

                <figure id="selectedFosterDogPhoto" class="public-side-photo-card" hidden>
                    <img id="selectedFosterDogImage" src="" alt="Selected foster dog" class="public-side-photo-image" loading="lazy" />
                    <figcaption id="selectedFosterDogCaption"></figcaption>
                </figure>
                <div id="generalFosterDogMessage" class="public-side-photo-fallback">
                    <strong>A safe home changes everything.</strong>
                    <p>Choose a dog above, or submit a general enquiry and our team will help you find a match.</p>
                </div>

            </div>

        </div>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {
            $("#AgreeToTerms").rules("add", {
                required: true,
                messages: {
                    required: "Please agree to the terms and privacy policy to continue."
                }
            });
        });

        const dogSelector = document.getElementById('DogId');
        const updateDogSelection = () => {
            const option = dogSelector?.selectedOptions?.[0];
            const hasDog = !!dogSelector?.value;
            const name = option?.dataset?.dogName || '';
            const photo = option?.dataset?.dogPhoto || '';
            const note = document.getElementById('selectedFosterDogNote');
            const photoCard = document.getElementById('selectedFosterDogPhoto');
            const fallback = document.getElementById('generalFosterDogMessage');
            const image = document.getElementById('selectedFosterDogImage');
            const size = document.getElementById('fosterSizePreferences');
            note.hidden = !hasDog;
            document.getElementById('selectedFosterDogName').textContent = name;
            size.hidden = hasDog;
            if (hasDog && photo) {
                image.src = photo;
                image.alt = 'Photo of ' + name;
                document.getElementById('selectedFosterDogCaption').textContent = name + ' could be your next foster.';
                photoCard.hidden = false;
                fallback.hidden = true;
            } else {
                image.removeAttribute('src');
                photoCard.hidden = true;
                fallback.hidden = false;
            }
        };
        dogSelector?.addEventListener('change', updateDogSelection);
        updateDogSelection();

        $("form.public-form-card").on("submit", function () {
            var form = $(this);

            if (form.valid()) {
                form.find("button[type=submit]").prop("disabled", true);
            }
        });
    </script>
}

