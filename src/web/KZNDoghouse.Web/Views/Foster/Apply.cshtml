@model FosterApplicationFormViewModel

@{
    ViewData["Title"] = "Apply to Foster";
    ViewData["Eyebrow"] = "Foster a Dog";
    ViewData["Heading"] = "Ready to open your door?";
    ViewData["Subtitle"] = "Fostering is a temporary home for a dog in need — no forever commitment, just a soft place to land while we find them one. Tell us a bit about your home and we'll take it from there.";

    var selectedDogName = ViewData["SelectedDogName"] as string;
    var selectedDogPhotoUrl = ViewData["SelectedDogPhotoUrl"] as string;
    var selectedDogPhotoName = ViewData["SelectedDogPhotoName"] as string;
}

<partial name="_PublicPageHeader" />

<section class="public-section">

    <div class="container">

        <div class="row g-4">

            <div class="col-lg-7">

                <form asp-action="Apply"
                      method="post"
                      class="public-form-card"
                      novalidate>

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <input type="hidden" asp-for="DogId" />

                    @if (Model.DogId.HasValue && !string.IsNullOrWhiteSpace(selectedDogName))
                    {
                        <p class="public-dog-note">
                            You are applying to foster <strong>@selectedDogName</strong>.
                        </p>
                    }

                    <fieldset class="public-form-section">

                        <legend>About you</legend>

                        <p class="public-form-hint">
                            We'll use this to get in touch about your application.
                        </p>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label"></label>
                                <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label"></label>
                                <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" type="email" class="form-control" autocomplete="email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label"></label>
                                <input asp-for="Phone" type="tel" class="form-control" autocomplete="tel" placeholder="+27 82 000 0000" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="HomeAddress" class="form-label"></label>
                                <input asp-for="HomeAddress" class="form-control" autocomplete="street-address" placeholder="Street, suburb, city" />
                                <span asp-validation-for="HomeAddress" class="text-danger"></span>
                            </div>

                        </div>

                    </fieldset>

                    <fieldset class="public-form-section">

                        <legend>Your home</legend>

                        <p class="public-form-hint">
                            Helps us match the right dog to your space.
                        </p>

                        <div class="public-question">
                            <label asp-for="HomeType" class="form-label"></label>

                            <select asp-for="HomeType" class="form-select">

                                <option value="">Choose your type of home</option>

                                @foreach (var option in FosterOptions.HomeTypes)
                                {
                                    <option value="@option"
                                            selected="@(Model.HomeType == option)">
                                        @option
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="HomeType" class="text-danger"></span>
                        </div>

                        <div class="public-question" role="group" aria-labelledby="q-fenced">
                            <p id="q-fenced" class="public-question-label">Is your garden fully fenced? *</p>
                            <div class="public-pill-group">
                                @foreach (var option in FosterOptions.FencedAnswers)
                                {
                                    <label class="public-pill">
                                        <input type="radio" asp-for="GardenFenced" value="@option" />
                                        <span>@option</span>
                                    </label>
                                }
                            </div>
                            <span asp-validation-for="GardenFenced" class="text-danger"></span>
                        </div>

                        <div class="public-question" role="group" aria-labelledby="q-grass">
                            <p id="q-grass" class="public-question-label">Is there grass, or could the dog be walked on grass every day? *</p>
                            <div class="public-pill-group">
                                <label class="public-pill"><input type="radio" asp-for="HasGrassOrDailyWalks" value="true" /><span>Yes</span></label>
                                <label class="public-pill"><input type="radio" asp-for="HasGrassOrDailyWalks" value="false" /><span>No</span></label>
                            </div>
                            <span asp-validation-for="HasGrassOrDailyWalks" class="text-danger"></span>
                        </div>

                        <div class="public-question" role="group" aria-labelledby="q-home">
                            <p id="q-home" class="public-question-label">Will someone be home during the day and night? *</p>
                            <div class="public-pill-group">
                                <label class="public-pill"><input type="radio" asp-for="SomeoneHomeDayAndNight" value="true" /><span>Yes</span></label>
                                <label class="public-pill"><input type="radio" asp-for="SomeoneHomeDayAndNight" value="false" /><span>No</span></label>
                            </div>
                            <span asp-validation-for="SomeoneHomeDayAndNight" class="text-danger"></span>
                        </div>

                        <div class="public-question" role="group" aria-labelledby="q-indoor">
                            <p id="q-indoor" class="public-question-label">Does the dog have an indoor place to sleep? *</p>
                            <div class="public-pill-group">
                                <label class="public-pill"><input type="radio" asp-for="HasIndoorSleepingArea" value="true" /><span>Yes</span></label>
                                <label class="public-pill"><input type="radio" asp-for="HasIndoorSleepingArea" value="false" /><span>No</span></label>
                            </div>
                            <span asp-validation-for="HasIndoorSleepingArea" class="text-danger"></span>
                        </div>

                        <div class="public-question" role="group" aria-labelledby="q-pets">
                            <p id="q-pets" class="public-question-label">Do you have other pets? *</p>
                            <div class="public-pill-group">
                                <label class="public-pill"><input type="radio" asp-for="HasOtherPets" value="true" /><span>Yes</span></label>
                                <label class="public-pill"><input type="radio" asp-for="HasOtherPets" value="false" /><span>No</span></label>
                            </div>
                            <span asp-validation-for="HasOtherPets" class="text-danger"></span>
                        </div>

                        <div class="public-question" role="group" aria-labelledby="q-children">
                            <p id="q-children" class="public-question-label">Are there children in the household? *</p>
                            <div class="public-pill-group">
                                <label class="public-pill"><input type="radio" asp-for="HasChildren" value="true" /><span>Yes</span></label>
                                <label class="public-pill"><input type="radio" asp-for="HasChildren" value="false" /><span>No</span></label>
                            </div>
                            <span asp-validation-for="HasChildren" class="text-danger"></span>
                        </div>

                    </fieldset>

                    <fieldset class="public-form-section">

                        <legend>Fostering preferences</legend>

                        <div class="public-question" role="group" aria-labelledby="q-size">
                            <p id="q-size" class="public-question-label">What size dog could you foster? *</p>
                            <div class="public-pill-group">
                                @foreach (var option in FosterOptions.SizePreferences)
                                {
                                    <label class="public-pill public-pill-round">
                                        <input type="checkbox"
                                               name="SizePreferences"
                                               value="@option"
                                               checked="@Model.SizePreferences.Contains(option)" />
                                        <span>@option</span>
                                    </label>
                                }
                            </div>
                            <span asp-validation-for="SizePreferences" class="text-danger"></span>
                        </div>

                        <div class="public-question" role="group" aria-labelledby="q-period">
                            <p id="q-period" class="public-question-label">How long could you foster for? *</p>
                            <div class="public-pill-group">
                                @foreach (var option in FosterPeriods.All)
                                {
                                    <label class="public-pill">
                                        <input type="radio" asp-for="FosterPeriod" value="@option" />
                                        <span>@option</span>
                                    </label>
                                }
                            </div>
                            <span asp-validation-for="FosterPeriod" class="text-danger"></span>
                        </div>

                        <div class="public-question">
                            <label asp-for="Motivation" class="form-label"></label>
                            <textarea asp-for="Motivation"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Experience with dogs, what you're hoping for, anything we should know&hellip;"></textarea>
                            <span asp-validation-for="Motivation" class="text-danger"></span>
                        </div>

                        <div class="form-check">
                            <input asp-for="AgreeToTerms" class="form-check-input" />
                            <label asp-for="AgreeToTerms" class="form-check-label">
                                I agree to The KZN Doghouse's <strong>Terms</strong>
                                and <strong>Privacy Policy</strong>, and understand
                                a home check may be required before approval.
                            </label>
                            <div>
                                <span asp-validation-for="AgreeToTerms" class="text-danger"></span>
                            </div>
                        </div>

                    </fieldset>

                    <div class="d-flex flex-wrap gap-3">

                        <button type="submit" class="btn btn-kzn-primary">
                            Submit application
                        </button>

                        <a asp-action="Index" class="btn btn-kzn-outline">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>

            <div class="col-lg-5">

                <div class="public-side-card">

                    <h2>How fostering works</h2>

                    <ol class="public-side-steps">

                        <li>
                            <span>1</span>
                            <div>
                                <strong>Apply</strong>
                                <p>Fill out this form &mdash; takes about 5 minutes.</p>
                            </div>
                        </li>

                        <li>
                            <span>2</span>
                            <div>
                                <strong>Home check</strong>
                                <p>A short call or visit to make sure it's a good fit.</p>
                            </div>
                        </li>

                        <li>
                            <span>3</span>
                            <div>
                                <strong>Matching</strong>
                                <p>We match you with a dog suited to your home.</p>
                            </div>
                        </li>

                        <li>
                            <span>4</span>
                            <div>
                                <strong>Foster</strong>
                                <p>We support you the whole way, from food to vet visits.</p>
                            </div>
                        </li>

                    </ol>

                </div>

                @if (!string.IsNullOrWhiteSpace(selectedDogPhotoUrl))
                {
                    <figure class="public-side-photo-card">
                        <img src="@selectedDogPhotoUrl"
                             alt="Photo of @(selectedDogPhotoName ?? "a KZN Doghouse rescue dog")"
                             class="public-side-photo-image"
                             loading="lazy" />
                        <figcaption>
                            @(selectedDogName != null
                                ? $"{selectedDogName} could be your next foster."
                                : "A temporary home can change a rescue dog's whole journey.")
                        </figcaption>
                    </figure>
                }
                else
                {
                    <div class="public-side-photo-fallback">
                        <span class="public-icon-box"><partial name="_PublicIcon" model="@("home")" /></span>
                        <strong>A safe home changes everything.</strong>
                        <p>
                            Foster carers give dogs time to settle, recover and get ready for
                            their permanent families.
                        </p>
                    </div>
                }

            </div>

        </div>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {
            $("#AgreeToTerms").rules("add", {
                required: true,
                messages: {
                    required: "Please agree to the terms and privacy policy to continue."
                }
            });
        });

        $("form.public-form-card").on("submit", function () {
            var form = $(this);

            if (form.valid()) {
                form.find("button[type=submit]").prop("disabled", true);
            }
        });
    </script>
}

