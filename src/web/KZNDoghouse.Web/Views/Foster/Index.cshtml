@{
    ViewData["Title"] = "Foster";
    ViewData["Subtitle"] = "Give a dog or puppy a safe, loving place to stay while they wait for a permanent home.";
}

<partial name="_PublicPageHeader" />

<section class="public-section">

    <div class="container">

        <div class="row g-4">

            <div class="col-lg-6">

                <div class="public-feature-card">

                    <h2 class="public-info-title">What fostering involves</h2>

                    <p class="mt-3">
                        Fostering gives dogs and puppies temporary care in a
                        home environment. Foster periods are flexible and are
                        designed to work around your availability.
                    </p>

                    <p class="mt-3">
                        Dogs in foster care remain part of the family of dogs
                        looked after by KZN Doghouse, so our team stays
                        involved and supports you throughout.
                    </p>

                </div>

            </div>

            <div class="col-lg-6">

                <div class="public-feature-card">

                    <h2 class="public-info-title">What we provide</h2>

                    <p class="mt-3">
                        We may supply foster parents with the essentials
                        needed to care for the dog, such as:
                    </p>

                    <ul class="public-check-list mb-0">
                        <li>Food and chicken</li>
                        <li>Blankets</li>
                        <li>Flea medication</li>
                        <li>Dewormer</li>
                        <li>Other required dog-care items</li>
                    </ul>

                </div>

            </div>

        </div>

    </div>

</section>

<section class="public-section public-section-alt">

    <div class="container">

        <div class="public-section-heading">

            <p class="public-section-label">
                Requirements
            </p>

            <h2 class="public-section-title">
                Is your home ready to foster?
            </h2>

            <p class="public-section-text">
                These requirements keep every foster dog safe and comfortable.
            </p>

        </div>

        <div class="row g-4">

            <div class="col-md-6 col-lg-3">

                <div class="public-feature-card">

                    <span class="public-feature-number">1</span>

                    <h3>Fully fenced property</h3>

                    <p>
                        The property should be fully fenced so the dog cannot
                        wander off.
                    </p>

                </div>

            </div>

            <div class="col-md-6 col-lg-3">

                <div class="public-feature-card">

                    <span class="public-feature-number">2</span>

                    <h3>Grass to play on</h3>

                    <p>
                        Grass on the property is preferred. If there is none,
                        the dog must be walked on grass every day.
                    </p>

                </div>

            </div>

            <div class="col-md-6 col-lg-3">

                <div class="public-feature-card">

                    <span class="public-feature-number">3</span>

                    <h3>Someone at home</h3>

                    <p>
                        Someone should be available during the day and night
                        to monitor the dog or puppy.
                    </p>

                </div>

            </div>

            <div class="col-md-6 col-lg-3">

                <div class="public-feature-card">

                    <span class="public-feature-number">4</span>

                    <h3>Indoor sleeping area</h3>

                    <p>
                        The dog or puppy must have somewhere to sleep
                        indoors.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>

<section class="public-cta">

    <div class="container">

        <h2>Ready to apply?</h2>

        <p class="mt-2">
            Tell us about your home and when you could foster, and our team
            will review your application.
        </p>

        <div class="mt-4">

            <a href="#"
               class="btn btn-kzn-gold disabled"
               aria-disabled="true">
                Apply to foster
            </a>

            <a asp-controller="PublicDogs"
               asp-action="Index"
               class="btn btn-outline-light ms-2">
                Meet our dogs
            </a>

        </div>

    </div>

</section>
