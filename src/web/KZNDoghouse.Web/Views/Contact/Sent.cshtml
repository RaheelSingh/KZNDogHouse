@{
    ViewData["Title"] = "Message sent";
}

<section class="public-section">

    <div class="container">

        <div class="public-empty-state" role="status">

            <h1 class="public-info-title">Thank you for getting in touch</h1>

            <p class="mt-3">
                We have received your message and will get back to you within
                2 business days.
            </p>

            <p class="mt-4">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-kzn-primary">
                    Back to home
                </a>
            </p>

        </div>

    </div>

</section>
