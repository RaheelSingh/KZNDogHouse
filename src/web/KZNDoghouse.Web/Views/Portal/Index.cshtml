@{
    ViewData["Title"] = "Dashboard";
    Layout = "_PortalLayout";
}

<div>

    <h1 class="portal-page-title">
        Dashboard
    </h1>

    <p class="text-muted mb-4">
        Welcome to the KZN Doghouse internal management system.
    </p>

    <div class="row g-3">

        <div class="col-md-4">

            <div class="portal-card">

                <h5>
                    Dogs
                </h5>

                <p>
                    Dog records and management will be available here.
                </p>

            </div>

        </div>

        <div class="col-md-4">

            <div class="portal-card">

                <h5>
                    Volunteers
                </h5>

                <p>
                    Volunteer availability and management will be available here.
                </p>

            </div>

        </div>

        <div class="col-md-4">

            <div class="portal-card">

                <h5>
                    Inventory
                </h5>

                <p>
                    Inventory and stock information will be available here.
                </p>

            </div>

        </div>

    </div>

</div>