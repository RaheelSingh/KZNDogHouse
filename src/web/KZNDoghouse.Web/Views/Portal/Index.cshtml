@{
    ViewData["Title"] = "Dashboard";
    Layout = "_PortalLayout";
}

<div class="container-fluid">
    <h1 class="mb-3">Dashboard</h1>

    <p class="text-muted">
        Welcome to the KZN Doghouse internal management system.
    </p>

    <div class="row g-3 mt-3">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Dogs</h5>
                    <p class="card-text">
                        Dog records and management will be available here.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Volunteers</h5>
                    <p class="card-text">
                        Volunteer availability and management will be available here.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Inventory</h5>
                    <p class="card-text">
                        Inventory and stock information will be available here.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>