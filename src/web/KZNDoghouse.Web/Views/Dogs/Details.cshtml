@model Dog

@{
    ViewData["Title"] = Model.Name;
    Layout = "_PortalLayout";
}

<div class="mb-3">
    <a asp-controller="Dogs" asp-action="Index" class="text-muted small">
        &larr; Dogs
    </a>
</div>

<div class="row g-4">

    <div class="col-lg-4">

        <div class="portal-card text-center">

            <div class="kzn-dog-avatar mx-auto mb-3"
                 style="width:96px;height:96px;font-size:2.5rem;">
                @Model.Name.Substring(0, 1).ToUpper()
            </div>

            <h4 class="mb-1">@Model.Name</h4>

            <p class="text-muted mb-2">
                @(Model.Breed ?? "Mixed breed")
                @if (Model.EstimatedAgeYears.HasValue)
                {
                    <text> · @Model.EstimatedAgeYears years</text>
                }
                · @Model.Gender
            </p>

            <partial name="_DogStatusBadge" model="@Model.Status" />

            <hr />

            <dl class="row text-start small mb-0">
                <dt class="col-5">Kennel</dt>
                <dd class="col-7">@(Model.KennelLocation ?? "—")</dd>

                <dt class="col-5">Intake date</dt>
                <dd class="col-7">@Model.IntakeDate.ToString("dd MMM yyyy")</dd>

                <dt class="col-5">Intake type</dt>
                <dd class="col-7">@(Model.IntakeType ?? "—")</dd>

                <dt class="col-5">Vaccinated</dt>
                <dd class="col-7">@(Model.IsVaccinated ? "Yes" : "No")</dd>
            </dl>

            <a asp-controller="Dogs"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-kzn-outline btn-sm mt-3">
                Edit profile
            </a>

        </div>

        <div class="portal-card mt-3">

            <label class="form-label">Change status</label>

            <form asp-controller="Dogs"
                  asp-action="UpdateStatus"
                  asp-route-id="@Model.Id"
                  method="post"
                  class="d-flex gap-2">

                <select name="status" class="form-select">
                    @foreach (var status in KZNDoghouse.Web.Constants.DogStatuses.All)
                    {
                        if (status == Model.Status)
                        {
                            <option value="@status" selected>@status</option>
                        }
                        else
                        {
                            <option value="@status">@status</option>
                        }
                    }
                </select>

                <button type="submit" class="btn btn-kzn-primary">Save</button>

            </form>

        </div>

    </div>

    <div class="col-lg-8">

        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <a class="nav-link active" data-bs-toggle="tab" href="#about-tab">About</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#medical-tab">Medical</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#fostering-tab">Fostering</a>
            </li>
        </ul>

        <div class="tab-content">

            <div class="tab-pane fade show active" id="about-tab">
                <div class="portal-card">
                    <h5 class="kzn-card-title">About @Model.Name</h5>
                    <p class="mb-0">@(Model.About ?? "No description added yet.")</p>
                    @if (!string.IsNullOrWhiteSpace(Model.Temperament))
                    {
                        <p class="text-muted mt-2 mb-0">Temperament: @Model.Temperament</p>
                    }
                </div>
            </div>

            <div class="tab-pane fade" id="medical-tab">
                <div class="portal-card">
                    <p class="text-muted mb-0">
                        Medical record management is coming in the next update.
                    </p>
                </div>
            </div>

            <div class="tab-pane fade" id="fostering-tab">
                <div class="portal-card">
                    <p class="text-muted mb-0">
                        Fostering history is coming in the next update.
                    </p>
                </div>
            </div>

        </div>

    </div>

</div>