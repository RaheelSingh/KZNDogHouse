@model IReadOnlyList<Dog>
@using KZNDoghouse.Web.Constants
@using KZNDoghouse.Web.Models

@{
    ViewData["Title"] = "Dogs";
    Layout = "_PortalLayout";

    var selectedStatus = ViewData["SelectedStatus"] as string;
}

<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">

    <div>

        <h1 class="portal-page-title mb-2">
            Dogs
        </h1>

        <p class="text-muted mb-0">
            @Model.Count dogs currently in our system.
        </p>

    </div>

    <a asp-controller="Dogs"
       asp-action="Create"
       class="btn btn-kzn-primary">
        + Add dog
    </a>

</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}

<div class="d-flex flex-wrap gap-2 mb-3">

    <a class="kzn-filter-pill @(selectedStatus == null ? "active" : "")"
       asp-controller="Dogs"
       asp-action="Index">
        All
    </a>

    @foreach (var status in DogStatuses.All)
    {
        <a class="kzn-filter-pill @(selectedStatus == status ? "active" : "")"
           asp-controller="Dogs"
           asp-action="Index"
           asp-route-status="@status">
            @status
        </a>
    }

</div>

<div class="portal-card">

    <div class="table-responsive">

        <table class="table align-middle mb-0">

            <thead>

                <tr>
                    <th>Dog</th>
                    <th>Status</th>
                    <th>Kennel</th>
                    <th>Intake date</th>
                    <th></th>
                </tr>

            </thead>

            <tbody>

                @foreach (var dog in Model)
                {
                    <tr>

                        <td>

                            <div class="d-flex align-items-center gap-2">

                                <div class="kzn-dog-avatar">
                                    @dog.Name.Substring(0, 1).ToUpper()
                                </div>

                                <div>

                                    <div class="fw-semibold">
                                        @dog.Name
                                    </div>

                                    <div class="text-muted small">
                                        @(dog.Breed ?? "Mixed breed")
                                        @if (dog.EstimatedAgeYears.HasValue)
                                        {
                                            <text> · @dog.EstimatedAgeYears yrs</text>
                                        }
                                    </div>

                                </div>

                            </div>

                        </td>

                        <td>
                            <partial name="_DogStatusBadge"
                                     model="@dog.Status" />
                        </td>

                        <td>
                            @(dog.KennelLocation ?? "—")
                        </td>

                        <td>
                            @dog.IntakeDate.ToString("dd MMM yyyy")
                        </td>

                        <td class="text-end">

                            <a asp-controller="Dogs"
                               asp-action="Details"
                               asp-route-id="@dog.Id"
                               class="btn btn-kzn-outline btn-sm">
                                View
                            </a>

                        </td>

                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5"
                            class="text-center text-muted py-4">
                            No dogs match this filter.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>