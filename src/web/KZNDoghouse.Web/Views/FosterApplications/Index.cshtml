@model IReadOnlyList<FosterApplicationListItem>
@using KZNDoghouse.Web.Constants

@{
    ViewData["Title"] = "Foster Applications";
    var assignableDogs = ViewData["AssignableDogs"] as IReadOnlyList<Dog> ?? Array.Empty<Dog>();
    Layout = "_PortalLayout";
}

<div class="portal-page-heading">
    <div>
        <h1 class="portal-page-title mb-2">Foster applications</h1>
        <p class="text-muted mb-0">Review and action fostering applications.</p>
    </div>

    <span class="portal-summary-chip">@Model.Count total</span>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="portal-card portal-workspace-filter-card">
    <div class="portal-filter-heading">
        <h2>Search &amp; Filter</h2>
    </div>

    <div class="portal-filter-bar portal-filter-bar-foster"
         data-portal-filter="fosterApplicationRows"
         data-portal-empty="fosterApplicationsEmpty"
         data-portal-result-count="fosterApplicationsResultCount">

        <div class="portal-filter-search">
            <input type="search"
                   class="form-control"
                   placeholder="Search applicant, email or dog"
                   aria-label="Search foster applications"
                   data-portal-search />
        </div>

        <div>
            <select class="form-select" aria-label="Filter foster applications" data-portal-filter-field="state">
                <option value="Open" selected>Open applications</option>
                <option value="">All applications</option>
                <option value="Completed">Completed</option>
            </select>
        </div>

        <div class="portal-filter-date">
            <label>From</label>
            <input type="date" class="form-control" data-portal-date-from="date" />
        </div>

        <div class="portal-filter-date">
            <label>To</label>
            <input type="date" class="form-control" data-portal-date-to="date" />
        </div>

        <button type="button"
                class="portal-sort-button"
                data-portal-sort-toggle
                data-sort-field="sortDate"
                data-sort-type="date"
                data-sort-direction="desc"
                data-sort-asc-label="Oldest"
                data-sort-desc-label="Newest"
                title="Sort by date, newest first"
                aria-label="Sort by date, newest first">
            <svg class="portal-sort-icon portal-sort-icon-up" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h9"></path><path d="M4 11h6"></path><path d="M4 16h3"></path><path d="M18 19V5"></path><path d="m15 8 3-3 3 3"></path></svg>
            <svg class="portal-sort-icon portal-sort-icon-down" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h9"></path><path d="M4 11h6"></path><path d="M4 16h3"></path><path d="M18 5v14"></path><path d="m15 16 3 3 3-3"></path></svg>
            <span data-portal-sort-label>Newest</span>
        </button>

        <button type="button" class="btn btn-kzn-outline portal-filter-reset" data-portal-filter-reset>Reset</button>
    </div>

    <div class="portal-filter-summary">
        <span id="fosterApplicationsResultCount">@Model.Count results</span>
    </div>
</div>

<div class="portal-card portal-list-card">
    <div class="table-responsive portal-record-scroll portal-table-scroll">
        <table class="table align-middle mb-0 portal-data-table">
            <thead>
                <tr>
                    <th>Applicant</th>
                    <th>Dog</th>
                    <th>Submitted</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="fosterApplicationRows">
                @foreach (var item in Model)
                {
                    var application = item.Application;
                    var isOpen = application.Status == FosterApplicationStatuses.Submitted
                        || application.Status == FosterApplicationStatuses.UnderReview;
                    var state = isOpen ? "Open" : "Completed";

                    <tr data-portal-row
                        data-search="@application.ApplicantName @application.ApplicantEmail @item.DogName"
                        data-state="@state"
                        data-date="@application.SubmittedAt.ToString("yyyy-MM-dd")"
                        data-sort-date="@application.SubmittedAt.ToString("O")">
                        <td>
                            <div class="fw-semibold">@application.ApplicantName</div>
                            <div class="text-muted small">@application.ApplicantEmail</div>
                            @if (!string.IsNullOrWhiteSpace(application.ApplicantPhone))
                            {
                                <div class="small"><a href="tel:@application.ApplicantPhone">Call @application.ApplicantPhone</a></div>
                            }
                            <a class="small" href="mailto:@application.ApplicantEmail">Email applicant</a>
                            @if (application.DogId.HasValue && isOpen)
                            {
                                <details class="foster-agreement-panel mt-3">
                                    <summary>Signed agreement (@item.Documents.Count)</summary>
                                    <div class="foster-agreement-content">
                                        @foreach (var document in item.Documents)
                                        {
                                            <a class="small" asp-controller="DogDocuments" asp-action="Download" asp-route-id="@document.Id">@document.FileName</a>
                                        }
                                        <form asp-controller="FosterApplications" asp-action="UploadAgreement" asp-route-id="@application.Id" method="post" enctype="multipart/form-data" class="foster-agreement-upload">
                                            <label class="form-label small" for="agreement-@application.Id">Signed agreement (PDF or image)</label>
                                            <input id="agreement-@application.Id" class="form-control form-control-sm" type="file" name="file" accept=".pdf,.docx,.jpg,.jpeg,.png,.webp,.gif" required />
                                            <button type="submit" class="btn btn-kzn-outline btn-sm">Upload agreement</button>
                                        </form>
                                    </div>
                                </details>
                            }
                            @if (!string.IsNullOrWhiteSpace(application.ApplicationDetails))
                            {
                                <details class="mt-2"><summary>View application answers</summary>
                                    <div class="small mt-2" style="white-space:pre-wrap">@application.ApplicationDetails</div>
                                </details>
                            }
                        </td>
                        <td>
                            @item.DogName
                            @if (!application.DogId.HasValue && isOpen)
                            {
                                <form asp-controller="FosterApplications" asp-action="AssignDog" asp-route-id="@application.Id" method="post" class="mt-2">
                                    <select name="dogId" class="form-select form-select-sm mb-1" aria-label="Select foster dog" required>
                                        <option value="">Choose a dog</option>
                                        @foreach (var dog in assignableDogs)
                                        {
                                            <option value="@dog.Id">@dog.Name</option>
                                        }
                                    </select>
                                    <button class="btn btn-kzn-outline btn-sm">Assign dog</button>
                                </form>
                            }
                        </td>
                        <td>@application.SubmittedAt.ToString("dd MMM yyyy")</td>
                        <td>@application.Status</td>
                        <td class="text-end">
                            @if (isOpen)
                            {
                                @if (application.DogId.HasValue)
                                {

                                }
                                @if (application.Status == FosterApplicationStatuses.Submitted)
                                {
                                    <form asp-controller="FosterApplications" asp-action="StartReview" asp-route-id="@application.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-kzn-outline btn-sm">Under review</button>
                                    </form>
                                }
                                <form asp-controller="FosterApplications" asp-action="Approve" asp-route-id="@application.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-kzn-primary btn-sm" title="Confirm placement after signed agreement is uploaded">Confirm foster placement</button>
                                </form>
                                <button type="button"
                                        class="btn btn-kzn-outline btn-sm"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#reject-@application.Id">
                                    Reject
                                </button>
                                <div class="collapse mt-2" id="reject-@application.Id">
                                    <form asp-controller="FosterApplications"
                                          asp-action="Reject"
                                          asp-route-id="@application.Id"
                                          method="post"
                                          class="d-flex gap-2 justify-content-end">
                                        <input name="rejectionReason"
                                               class="form-control form-control-sm portal-rejection-input"
                                               placeholder="Reason"
                                               required />
                                        <button type="submit" class="btn btn-kzn-outline btn-sm">Confirm</button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted small">Completed</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div id="fosterApplicationsEmpty" class="portal-filter-empty" hidden>
            No foster applications match the current search and filters.
        </div>
    </div>
</div>
