@model InventoryPageViewModel
@using KZNDoghouse.Web.Constants

@{
    ViewData["Title"] = "Inventory";
    Layout = "_PortalLayout";

    var categories = Model.Items
        .Where(x => !string.IsNullOrWhiteSpace(x.Item.Category))
        .Select(x => x.Item.Category!)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();
}

<div class="portal-page-heading">
    <div>
        <h1 class="portal-page-title mb-2">Inventory</h1>
        <p class="text-muted mb-0">Track current stock, deliveries, usage, expiry dates and low-stock levels.</p>
    </div>

    <div class="portal-page-summary">
        <span class="portal-summary-chip">@Model.Items.Count items</span>
        <span class="portal-summary-chip @(Model.LowStockCount > 0 ? "portal-summary-chip-warning" : string.Empty)">@Model.LowStockCount low stock</span>
        <span class="portal-summary-chip @(Model.ExpiringSoonCount > 0 ? "portal-summary-chip-warning" : string.Empty)">@Model.ExpiringSoonCount expiring soon</span>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="portal-workspace-grid portal-equal-workspace" data-equal-workspace>
    <section class="portal-workspace-main">

        <div class="portal-card portal-workspace-filter-card">
            <div class="portal-filter-heading">
                <h2>Search &amp; Filter</h2>
            </div>

            <div class="portal-filter-bar portal-filter-bar-inventory"
                 data-portal-filter="inventoryItems"
                 data-portal-empty="inventoryEmpty"
                 data-portal-result-count="inventoryResultCount">

                <div class="portal-filter-search">
                    <input type="search"
                           class="form-control"
                           placeholder="Search item, category or unit"
                           data-portal-search />
                </div>

                <div>
                    <select class="form-select" data-portal-filter-field="category" aria-label="Filter by category">
                        <option value="">All categories</option>
                        @foreach (var category in categories)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                </div>

                <div>
                    <select class="form-select" data-portal-filter-field="stock" aria-label="Filter by stock level">
                        <option value="">All stock levels</option>
                        <option value="Low">Low stock</option>
                        <option value="Healthy">Above threshold</option>
                    </select>
                </div>

                <div>
                    <select class="form-select" data-portal-filter-field="expiry" aria-label="Filter by expiry">
                        <option value="">All expiry states</option>
                        <option value="Expired">Expired</option>
                        <option value="Expiring Soon">Expiring soon</option>
                        <option value="Dated">Has future expiry</option>
                        <option value="No Expiry">No expiry recorded</option>
                    </select>
                </div>

                <button type="button"
                        class="portal-sort-button"
                        data-portal-sort-toggle
                        data-sort-field="sortName"
                        data-sort-type="text"
                        data-sort-direction="asc"
                        data-sort-asc-label="A–Z"
                        data-sort-desc-label="Z–A">
                    <svg class="portal-sort-icon portal-sort-icon-up" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h9"></path><path d="M4 11h6"></path><path d="M4 16h3"></path><path d="M18 19V5"></path><path d="m15 8 3-3 3 3"></path></svg>
                    <svg class="portal-sort-icon portal-sort-icon-down" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h9"></path><path d="M4 11h6"></path><path d="M4 16h3"></path><path d="M18 5v14"></path><path d="m15 16 3 3 3-3"></path></svg>
                    <span data-portal-sort-label>A–Z</span>
                </button>

                <button type="button" class="btn btn-kzn-outline portal-filter-reset" data-portal-filter-reset>Reset</button>
            </div>

            <div class="portal-filter-summary">
                <span id="inventoryResultCount">@Model.Items.Count results</span>
            </div>
        </div>

        <div id="inventoryItems"
             class="portal-record-scroll portal-record-scroll-workspace portal-filter-results portal-inventory-list"
             data-equal-workspace-scroll>

            @foreach (var summary in Model.Items)
            {
                var item = summary.Item;
                var stockState = item.IsLowStock() ? "Low" : "Healthy";

                <article class="portal-card portal-inventory-row"
                         data-portal-row
                         data-search="@item.Name @item.Category @item.Unit"
                         data-category="@item.Category"
                         data-stock="@stockState"
                         data-expiry="@summary.ExpiryState"
                         data-sort-name="@item.Name">

                    <div class="portal-inventory-row-main">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Name" class="portal-inventory-row-image" />
                        }
                        else
                        {
                            <div class="portal-inventory-row-image portal-inventory-image-placeholder" aria-hidden="true">
                                @item.Name[..1].ToUpperInvariant()
                            </div>
                        }

                        <div class="portal-inventory-row-name">
                            <h2>@item.Name</h2>
                            <span>@(item.Category ?? "Uncategorised")</span>
                        </div>

                        <div class="portal-inventory-row-metric">
                            <strong>@item.Quantity</strong>
                            <span>@(item.Unit ?? "units") in stock</span>
                        </div>

                        <div class="portal-inventory-row-details">
                            <span>Low-stock alert: @item.LowStockThreshold @(item.Unit ?? "units")</span>
                            @if (summary.NextExpiryDate.HasValue)
                            {
                                <span class="@(summary.IsExpired || summary.IsExpiringSoon ? "text-danger" : string.Empty)">
                                    Expiry: @summary.NextExpiryDate.Value.ToString("dd MMM yyyy")
                                </span>
                            }
                            else
                            {
                                <span>No expiry recorded</span>
                            }
                        </div>

                        <div class="portal-inventory-row-status">
                            @if (item.IsLowStock())
                            {
                                <span class="kzn-status-badge kzn-status-under-treatment">Low stock</span>
                            }
                            else if (summary.IsExpired)
                            {
                                <span class="kzn-status-badge kzn-status-under-treatment">Expired</span>
                            }
                            else if (summary.IsExpiringSoon)
                            {
                                <span class="kzn-status-badge kzn-status-in-care">Expiring soon</span>
                            }
                            else
                            {
                                <span class="kzn-status-badge kzn-status-available">In stock</span>
                            }
                        </div>

                        <div class="portal-inventory-row-actions">
                            <button type="button"
                                    class="btn btn-kzn-primary btn-sm"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#stock-@item.Id"
                                    aria-expanded="false"
                                    aria-controls="stock-@item.Id">
                                Manage stock
                            </button>
                            <button type="button"
                                    class="btn btn-kzn-outline btn-sm"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#history-@item.Id"
                                    aria-expanded="false"
                                    aria-controls="history-@item.Id">
                                History
                            </button>
                        </div>
                    </div>

                    <div class="collapse portal-inventory-row-expand" id="stock-@item.Id">
                        <form asp-controller="Inventory"
                              asp-action="RecordTransaction"
                              method="post"
                              class="portal-inventory-stock-form">
                            <input type="hidden" name="itemId" value="@item.Id" />

                            <div>
                                <label class="form-label">What happened?</label>
                                <select name="transactionType" class="form-select" required>
                                    <option value="@InventoryTransactionTypes.Delivery">Stock received</option>
                                    <option value="@InventoryTransactionTypes.Usage">Stock used</option>
                                    <option value="@InventoryTransactionTypes.Adjustment">Manual adjustment</option>
                                </select>
                            </div>

                            <div>
                                <label class="form-label">Quantity</label>
                                <input type="number" name="quantityChange" class="form-control" required />
                            </div>

                            <div>
                                <label class="form-label">Expiry date</label>
                                <input type="date" name="expiryDate" class="form-control" />
                            </div>

                            <div class="portal-inventory-stock-notes">
                                <label class="form-label">Notes</label>
                                <input name="notes" class="form-control" maxlength="500" placeholder="Supplier, reason, batch..." />
                            </div>

                            <div class="portal-inventory-stock-submit">
                                <div class="form-text">Received/used quantities are entered as positive numbers. Manual adjustment may be positive or negative.</div>
                                <button type="submit" class="btn btn-kzn-primary btn-sm">Update stock</button>
                            </div>
                        </form>

                        <details class="portal-inline-editor mt-3">
                            <summary>@(string.IsNullOrWhiteSpace(item.ImageUrl) ? "Add item image" : "Replace item image")</summary>
                            <form asp-controller="Inventory"
                                  asp-action="UpdateImage"
                                  method="post"
                                  enctype="multipart/form-data"
                                  class="portal-inline-editor-form">
                                <input type="hidden" name="itemId" value="@item.Id" />
                                <input type="file"
                                       name="imageFile"
                                       class="form-control form-control-sm"
                                       accept="image/jpeg,image/png,image/webp"
                                       required />
                                <button type="submit" class="btn btn-kzn-outline btn-sm">Upload</button>
                            </form>
                        </details>
                    </div>

                    <div class="collapse portal-inventory-row-expand" id="history-@item.Id">
                        <div class="portal-inventory-history">
                            @if (!summary.RecentTransactions.Any())
                            {
                                <p class="text-muted small mb-0">No stock transactions recorded yet.</p>
                            }
                            else
                            {
                                @foreach (var transaction in summary.RecentTransactions)
                                {
                                    <div class="portal-inventory-history-row">
                                        <div>
                                            <strong>@transaction.TransactionType</strong>
                                            <span>@(transaction.QuantityChange > 0 ? "+" : string.Empty)@transaction.QuantityChange @(item.Unit ?? "units")</span>
                                            @if (!string.IsNullOrWhiteSpace(transaction.Notes))
                                            {
                                                <small>@transaction.Notes</small>
                                            }
                                        </div>
                                        <div class="text-end">
                                            <span>@transaction.TransactionDate.ToString("dd MMM yyyy HH:mm")</span>
                                            @if (transaction.ExpiryDate.HasValue)
                                            {
                                                <small>Expiry @transaction.ExpiryDate.Value.ToString("dd MMM yyyy")</small>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </article>
            }
        </div>

        <div id="inventoryEmpty" class="portal-card portal-filter-empty" hidden>
            No inventory items match the current search and filters.
        </div>

        @if (!Model.Items.Any())
        {
            <div class="portal-card text-center text-muted py-4">No inventory items have been added yet.</div>
        }
    </section>

    <aside class="portal-workspace-aside">
        <div class="portal-card portal-workspace-form-card" data-equal-workspace-form>
            <h2 class="portal-workspace-form-title">Add inventory item</h2>
            <p class="text-muted small">Create an item once, then use Manage stock whenever stock arrives, is used, or needs correcting.</p>

            <form asp-controller="Inventory" asp-action="CreateItem" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <input name="name" class="form-control" maxlength="150" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Category</label>
                    <input name="category" class="form-control" maxlength="100" placeholder="Food, medication, cleaning..." />
                </div>
                <div class="mb-3">
                    <label class="form-label">Unit</label>
                    <input name="unit" class="form-control" maxlength="50" placeholder="bags, bottles, tablets..." />
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label">Starting quantity</label>
                        <input type="number" min="0" name="initialQuantity" class="form-control" value="0" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Low-stock level</label>
                        <input type="number" min="0" name="lowStockThreshold" class="form-control" value="0" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Starting stock expiry</label>
                    <input type="date" name="initialExpiryDate" class="form-control" />
                    <div class="form-text">Leave blank for items that do not expire.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Item image</label>
                    <input type="file" name="imageFile" class="form-control" accept="image/jpeg,image/png,image/webp" />
                </div>
                <button type="submit" class="btn btn-kzn-primary w-100">Add item</button>
            </form>
        </div>
    </aside>
</div>
