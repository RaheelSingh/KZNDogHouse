@model NewPasswordViewModel

@{
    ViewData["Title"] = "Choose a New Password";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-7 col-lg-5">

            <div class="kzn-card">

                <div class="alert alert-success"
                     role="alert">
                    Code verified. Choose a new password to finish.
                </div>

                <div class="mb-4">

                    <h1 class="h3 kzn-card-title">
                        Choose a new password
                    </h1>

                    <p class="text-muted mb-0">
                        After saving, you'll be signed out everywhere and can sign in with your new password.
                    </p>

                </div>

                <form class="auth-form"
                      asp-controller="Auth"
                      asp-action="NewPassword"
                      method="post"
                      data-single-submit>

                    <input asp-for="Ticket"
                           type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">

                        <label asp-for="NewPassword"
                               class="form-label">
                        </label>

                        <div class="auth-password-wrap">

                            <input asp-for="NewPassword"
                                   class="form-control"
                                   autocomplete="new-password" />

                            <button type="button" class="auth-password-toggle" data-password-toggle aria-label="Show password" aria-pressed="false" title="Show password">

                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2 12s3.8-6 10-6 10 6 10 6-3.8 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>

                            </button>

                        </div>

                        <span asp-validation-for="NewPassword"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            Password must be at least 8 characters and include an uppercase letter, a number and a special character.
                        </div>

                    </div>

                    <div class="mb-4">

                        <label asp-for="ConfirmPassword"
                               class="form-label">
                        </label>

                        <div class="auth-password-wrap">

                            <input asp-for="ConfirmPassword"
                                   class="form-control"
                                   autocomplete="new-password" />

                            <button type="button" class="auth-password-toggle" data-password-toggle aria-label="Show confirmed password" aria-pressed="false" title="Show password">

                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2 12s3.8-6 10-6 10 6 10 6-3.8 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>

                            </button>

                        </div>

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger">
                        </span>

                    </div>

                    <button type="submit"
                            class="btn btn-kzn-primary w-100"
                            data-busy-text="Saving…">
                        Save new password
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/password-reset.js" asp-append-version="true"></script>
}