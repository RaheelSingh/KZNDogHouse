@model ResetCodeViewModel

@{
    ViewData["Title"] = "Enter Your Code";
    var hasEmail = !string.IsNullOrWhiteSpace(Model.Email);
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-7 col-lg-5">

            <div class="kzn-card">

                @if (TempData["PasswordResetInfo"] is string info)
                {
                    <div class="alert alert-info"
                         role="alert">
                        @info
                    </div>
                }

                @if (ViewData["RateLimitMessage"] is string rateLimitMessage)
                {
                    <div class="alert alert-warning"
                         role="alert">
                        @rateLimitMessage
                    </div>
                }

                <div class="mb-4">

                    <h1 class="h3 kzn-card-title">
                        Enter your code
                    </h1>

                    <p class="text-muted mb-0">
                        Type the verification code from the email we sent you. Codes expire after 15 minutes, and only the latest code works.
                    </p>

                </div>

                <form class="auth-form"
                      asp-controller="Auth"
                      asp-action="ResetCode"
                      method="post"
                      data-single-submit>

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">

                        <label asp-for="Email"
                               class="form-label">
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               autocomplete="email"
                               inputmode="email"
                               autocapitalize="none"
                               spellcheck="false" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-4">

                        <label asp-for="Code"
                               class="form-label">
                        </label>

                        <input asp-for="Code"
                               class="form-control"
                               inputmode="numeric"
                               autocomplete="one-time-code"
                               maxlength="10"
                               spellcheck="false" />

                        <span asp-validation-for="Code"
                              class="text-danger">
                        </span>

                    </div>

                    <button type="submit"
                            class="btn btn-kzn-primary w-100"
                            data-busy-text="Checking code…">
                        Verify code
                    </button>

                </form>

                @if (hasEmail)
                {
                    <form asp-controller="Auth"
                          asp-action="ForgotPassword"
                          method="post"
                          class="mt-3"
                          data-single-submit>

                        <input type="hidden"
                               name="Email"
                               value="@Model.Email" />

                        <button type="submit"
                                class="btn btn-kzn-outline w-100"
                                data-countdown-seconds="@Model.ResendAvailableInSeconds"
                                data-ready-text="Resend code"
                                data-countdown-text="Resend code in {time}"
                                data-busy-text="Sending…">
                            Resend code
                        </button>

                    </form>
                }
                else
                {
                    <p class="text-center text-muted mt-3 mb-0">
                        Need a code?

                        <a asp-controller="Auth"
                           asp-action="ForgotPassword">
                            Request one
                        </a>
                    </p>
                }

                <p class="text-center text-muted mt-4 mb-0">
                    <a asp-controller="Auth"
                       asp-action="Login">
                        Back to sign in
                    </a>
                </p>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/password-reset.js" asp-append-version="true"></script>
}