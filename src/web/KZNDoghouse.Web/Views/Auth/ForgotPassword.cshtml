@model ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-7 col-lg-5">

            <div class="kzn-card">

                @if (TempData["PasswordResetInfo"] is string info)
                {
                    <div class="alert alert-info"
                         role="alert">
                        @info
                    </div>
                }

                @if (ViewData["RateLimitMessage"] is string rateLimitMessage)
                {
                    <div class="alert alert-warning"
                         role="alert">
                        @rateLimitMessage
                    </div>
                }

                <div class="mb-4">

                    <h1 class="h3 kzn-card-title">
                        Forgot your password?
                    </h1>

                    <p class="text-muted mb-0">
                        Enter the email address you use to sign in and we'll email you a verification code.
                    </p>

                </div>

                <form class="auth-form"
                      asp-controller="Auth"
                      asp-action="ForgotPassword"
                      method="post"
                      data-single-submit>

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-4">

                        <label asp-for="Email"
                               class="form-label">
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               autocomplete="email"
                               inputmode="email"
                               autocapitalize="none"
                               spellcheck="false" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>

                    <button type="submit"
                            class="btn btn-kzn-primary w-100"
                            data-busy-text="Sending code…">
                        Send code
                    </button>

                </form>

                <p class="text-center text-muted mt-4 mb-0">
                    Remembered it?

                    <a asp-controller="Auth"
                       asp-action="Login">
                        Back to sign in
                    </a>
                </p>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/password-reset.js" asp-append-version="true"></script>
}