@model PublicDogDetails

@{
    ViewData["Title"] = Model.Name;
    ViewData["Subtitle"] = Model.Breed;
}

<partial name="_PublicPageHeader" />

<section class="public-section">

    <div class="container">

        <p>
            <a asp-action="Index">&larr; All dogs</a>
        </p>

        <div class="row g-4">

            <div class="col-lg-6">

                @if (!string.IsNullOrWhiteSpace(Model.PhotoUrl))
                {
                    <img class="public-dog-photo public-dog-detail-photo"
                         src="@Model.PhotoUrl"
                         alt="Photo of @Model.Name" />
                }
                else
                {
                    <div class="public-dog-photo public-dog-photo-placeholder public-dog-detail-photo"
                         aria-hidden="true">
                        @Model.Name.Substring(0, 1).ToUpperInvariant()
                    </div>
                }

            </div>

            <div class="col-lg-6">

                <div class="public-feature-card">

                    <h2 class="public-dog-name">About @Model.Name</h2>

                    @if (!string.IsNullOrWhiteSpace(Model.About))
                    {
                        <p class="mt-3">@Model.About</p>
                    }
                    else
                    {
                        <p class="mt-3">
                            We are still getting to know @Model.Name.
                            Check back soon for more about their story.
                        </p>
                    }

                    <dl class="public-fact-list">

                        <div>
                            <dt>Gender</dt>
                            <dd>@Model.Gender</dd>
                        </div>

                        <div>
                            <dt>Age</dt>
                            <dd>@Model.AgeText</dd>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Size))
                        {
                            <div>
                                <dt>Size</dt>
                                <dd>@Model.Size</dd>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.Temperament))
                        {
                            <div>
                                <dt>Temperament</dt>
                                <dd>@Model.Temperament</dd>
                            </div>
                        }

                        <div>
                            <dt>Vaccinated</dt>
                            <dd>@(Model.IsVaccinated ? "Yes" : "Not yet")</dd>
                        </div>

                    </dl>

                </div>

            </div>

        </div>

    </div>

</section>
