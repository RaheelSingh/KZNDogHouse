@model PublicDogListViewModel

@{
    ViewData["Title"] = "Our Dogs";
    ViewData["Subtitle"] = "Meet the dogs currently looking for a loving home.";

    var loadFailed = ViewData["LoadFailed"] as bool? == true;
    var filter = Model.Filter;

    var failedMessage = new PublicMessageViewModel
    {
        Title = "We could not load our dogs",
        Message = "Please try again in a few minutes."
    };

    var emptyMessage = new PublicMessageViewModel
    {
        Title = "No dogs available right now",
        Message = "Please check back soon, as new dogs arrive regularly."
    };

    var noMatchMessage = new PublicMessageViewModel
    {
        Title = "No dogs match your search",
        Message = "Try a different search or clear the filters to see everyone."
    };
}

<partial name="_PublicPageHeader" />

<section class="public-section">

    <div class="container">

        @if (loadFailed)
        {
            <partial name="_PublicEmptyState" model="failedMessage" />
        }
        else if (Model.TotalCount == 0)
        {
            <partial name="_PublicEmptyState" model="emptyMessage" />
        }
        else
        {
            <form asp-action="Index"
                  method="get"
                  class="public-filter-bar"
                  role="search">

                <div class="row g-3 align-items-end">

                    <div class="col-md-5">

                        <label for="search" class="form-label">Search</label>

                        <input id="search"
                               name="search"
                               type="search"
                               class="form-control"
                               maxlength="@PublicDogFilter.MaxTextLength"
                               placeholder="Name, breed or temperament"
                               value="@filter.Search" />

                    </div>

                    <div class="col-6 col-md-2">

                        <label for="gender" class="form-label">Gender</label>

                        <select id="gender" name="gender" class="form-select">

                            <option value="">Any</option>

                            @foreach (var option in PublicDogFilter.GenderOptions)
                            {
                                <option value="@option"
                                        selected="@(filter.Gender == option)">
                                    @option
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-6 col-md-2">

                        <label for="size" class="form-label">Size</label>

                        <select id="size" name="size" class="form-select">

                            <option value="">Any</option>

                            @foreach (var option in Model.SizeOptions)
                            {
                                <option value="@option"
                                        selected="@string.Equals(filter.Size, option, StringComparison.OrdinalIgnoreCase)">
                                    @option
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-md-3 d-flex gap-2">

                        <button type="submit" class="btn btn-kzn-primary">
                            Search
                        </button>

                        @if (filter.IsActive)
                        {
                            <a asp-action="Index" class="btn btn-kzn-outline">
                                Clear
                            </a>
                        }

                    </div>

                </div>

            </form>

            <p class="public-result-count" aria-live="polite">
                Showing @Model.Dogs.Count of @Model.TotalCount
                @(Model.TotalCount == 1 ? "dog" : "dogs")
            </p>

            @if (Model.Dogs.Count == 0)
            {
                <partial name="_PublicEmptyState" model="noMatchMessage" />
            }
            else
            {
                <div class="row g-4">

                    @foreach (var dog in Model.Dogs)
                    {
                        <div class="col-sm-6 col-lg-4">

                            <div class="public-dog-card">

                                @if (!string.IsNullOrWhiteSpace(dog.PhotoUrl))
                                {
                                    <img class="public-dog-photo"
                                         src="@dog.PhotoUrl"
                                         alt="Photo of @dog.Name"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="public-dog-photo public-dog-photo-placeholder"
                                         aria-hidden="true">
                                        @dog.Name.Substring(0, 1).ToUpperInvariant()
                                    </div>
                                }

                                <div class="public-dog-body">

                                    <h2 class="public-dog-name">
                                        <a asp-action="Details"
                                           asp-route-id="@dog.Id"
                                           class="public-dog-link stretched-link">
                                            @dog.Name
                                        </a>
                                    </h2>

                                    @if (!string.IsNullOrWhiteSpace(dog.Breed))
                                    {
                                        <p class="public-dog-breed">@dog.Breed</p>
                                    }

                                    <ul class="public-dog-tags">
                                        <li>@dog.Gender</li>
                                        <li>@dog.AgeText</li>

                                        @if (!string.IsNullOrWhiteSpace(dog.Size))
                                        {
                                            <li>@dog.Size</li>
                                        }
                                    </ul>

                                    @if (!string.IsNullOrWhiteSpace(dog.Temperament))
                                    {
                                        <p class="public-dog-text">@dog.Temperament</p>
                                    }

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }
        }

    </div>

</section>
