@model PublicDogListViewModel

@{
    ViewData["Title"] = "Meet the Dogs";

    var loadFailed = ViewData["LoadFailed"] as bool? == true;
    var filter = Model.Filter;
    var sortRoute = filter.Sort == PublicDogFilter.SortNewest ? null : filter.Sort;

    string ChipUrl(string? chipSize, string? chipStatus) =>
        Url.Action("Index", "PublicDogs", new
        {
            size = chipSize,
            status = chipStatus,
            sort = sortRoute
        }) ?? "#";

    var failedMessage = new PublicMessageViewModel
    {
        Title = "We could not load our dogs",
        Message = "Please try again in a few minutes."
    };

    var emptyMessage = new PublicMessageViewModel
    {
        Title = "No dogs available right now",
        Message = "Please check back soon, as new dogs arrive regularly."
    };

    var noMatchMessage = new PublicMessageViewModel
    {
        Title = "No dogs match these filters",
        Message = "Try a different filter, or show all dogs to see everyone."
    };
}

<section class="public-page-header">

    <div class="container">

        <p class="public-page-eyebrow">Meet the Dogs</p>

        <h1 class="public-page-title">Looking for a home.</h1>

        <p class="public-page-subtitle">
            Every dog here has been vet-checked, sterilised, and is ready to
            meet their new family. Tap a face to learn their story.
        </p>

        @if (!loadFailed && Model.OverallCount > 0)
        {
            <nav class="public-chip-row" aria-label="Filter dogs">

                <a href="@ChipUrl(null, null)"
                   class="public-chip@(filter.IsActive ? string.Empty : " active")"
                   aria-current="@(filter.IsActive ? null : "true")">
                    All dogs
                </a>

                @foreach (var option in PublicDogFilter.SizeOptions)
                {
                    var isActive = filter.Size == option;

                    <a href="@ChipUrl(isActive ? null : option, filter.Status)"
                       class="public-chip@(isActive ? " active" : string.Empty)"
                       aria-current="@(isActive ? "true" : null)">
                        @option
                    </a>
                }

                <a href="@ChipUrl(filter.Size, filter.Status == PublicDogFilter.StatusReady ? null : PublicDogFilter.StatusReady)"
                   class="public-chip@(filter.Status == PublicDogFilter.StatusReady ? " active" : string.Empty)"
                   aria-current="@(filter.Status == PublicDogFilter.StatusReady ? "true" : null)">
                    Ready to adopt
                </a>

                <a href="@ChipUrl(filter.Size, filter.Status == PublicDogFilter.StatusFoster ? null : PublicDogFilter.StatusFoster)"
                   class="public-chip@(filter.Status == PublicDogFilter.StatusFoster ? " active" : string.Empty)"
                   aria-current="@(filter.Status == PublicDogFilter.StatusFoster ? "true" : null)">
                    In foster care
                </a>

            </nav>
        }

    </div>

</section>

<section class="public-section">

    <div class="container">

        @if (loadFailed)
        {
            <partial name="_PublicEmptyState" model="failedMessage" />
        }
        else if (Model.OverallCount == 0)
        {
            <partial name="_PublicEmptyState" model="emptyMessage" />
        }
        else
        {
            <div class="public-list-bar">

                <p class="public-result-count" aria-live="polite">
                    Showing @Model.Dogs.Count of @Model.MatchCount
                    @(Model.MatchCount == 1 ? "dog" : "dogs") looking for a home
                </p>

                <form asp-action="Index"
                      method="get"
                      class="public-sort">

                    @if (filter.Size != null)
                    {
                        <input type="hidden" name="size" value="@filter.Size" />
                    }

                    @if (filter.Status != null)
                    {
                        <input type="hidden" name="status" value="@filter.Status" />
                    }

                    <label for="sort" class="visually-hidden">Sort dogs</label>

                    <select id="sort"
                            name="sort"
                            class="form-select"
                            onchange="this.form.submit()">

                        <option value="@PublicDogFilter.SortNewest"
                                selected="@(filter.Sort == PublicDogFilter.SortNewest)">
                            Newest first
                        </option>

                        <option value="@PublicDogFilter.SortName"
                                selected="@(filter.Sort == PublicDogFilter.SortName)">
                            Name (A&ndash;Z)
                        </option>

                    </select>

                    <noscript>
                        <button type="submit" class="btn btn-kzn-outline">Sort</button>
                    </noscript>

                </form>

            </div>

            @if (Model.Dogs.Count == 0)
            {
                <partial name="_PublicEmptyState" model="noMatchMessage" />

                <p class="text-center mt-4">
                    <a asp-action="Index" class="btn btn-kzn-primary">
                        Show all dogs
                    </a>
                </p>
            }
            else
            {
                <div class="row g-4">

                    @foreach (var dog in Model.Dogs)
                    {
                        <div class="col-sm-6 col-lg-3">
                            <partial name="_PublicDogCard" model="dog" />
                        </div>
                    }

                </div>

                @if (Model.HasMore)
                {
                    <p class="text-center mt-5">
                        <a asp-action="Index"
                           asp-route-size="@filter.Size"
                           asp-route-status="@filter.Status"
                           asp-route-sort="@sortRoute"
                           asp-route-take="@Model.NextTake"
                           class="btn btn-kzn-outline">
                            Load more dogs
                        </a>
                    </p>
                }
            }
        }

    </div>

</section>
