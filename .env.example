# KZN Doghouse - Environment Variable Template
#
# Copy this file locally as ".env" where required.
# NEVER place real credentials in this example file.
# NEVER commit service-role keys or other private credentials.
#

# Supabase

SUPABASE_URL=
SUPABASE_ANON_KEY=

# SERVER ONLY.
# Never expose this value to the browser or mobile application.
SUPABASE_SERVICE_ROLE_KEY=

# ASP.NET Core Web / API

ASPNETCORE_ENVIRONMENT=Development

# Local example:
# API_BASE_URL=https://localhost:5001
API_BASE_URL=

# React Native / Expo

# Values prefixed with EXPO_PUBLIC_ can be exposed to the client.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Firebase Cloud Messaging

FIREBASE_PROJECT_ID=